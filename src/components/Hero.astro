---
---

<section
  class="relative flex flex-col items-center justify-center overflow-hidden bg-brand-black pt-20"
  style="min-height: 100svh;"
>
  <!-- Background grid -->
  <div
    class="absolute inset-0 bg-[linear-gradient(rgba(30,41,59,0.2)_1px,transparent_1px),linear-gradient(90deg,rgba(30,41,59,0.2)_1px,transparent_1px)] bg-[size:60px_60px]"
  >
  </div>

  <!-- Radial glow -->
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_70%_50%_at_50%_-10%,rgba(59,130,246,0.12),transparent)]"
  >
  </div>

  <!-- Subtle blobs -->
  <div
    class="absolute top-1/4 left-1/4 w-96 h-96 bg-brand-blue/8 rounded-full blur-3xl animate-blob"
  >
  </div>
  <div
    class="absolute top-1/3 right-1/4 w-96 h-96 bg-brand-purple/8 rounded-full blur-3xl animate-blob animation-delay-2000"
  >
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-5xl mx-auto px-4 text-center">
    <!-- Badge -->
    <div
      class="inline-flex items-center gap-2 border border-brand-blue/25 bg-brand-blue/8 text-brand-blue text-xs px-4 py-2 rounded-full mb-10 tracking-wider uppercase font-medium"
      data-aos="fade-down"
    >
      <span class="w-1.5 h-1.5 bg-brand-blue rounded-full animate-pulse"></span>
      Agencia Digital · Santiago, Chile
    </div>

    <!-- Headline -->
    <h1
      class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold leading-[1.1] mb-6 tracking-tight"
      data-aos="fade-up"
      data-aos-delay="100"
    >
      Soluciones digitales para{' '}
      <span
        class="bg-gradient-to-r from-brand-blue to-brand-purple bg-clip-text text-transparent"
      >
        negocios que crecen
      </span>
    </h1>

    <!-- Subtitle -->
    <p
      class="text-brand-muted text-lg md:text-xl max-w-2xl mx-auto mb-12 leading-relaxed"
      data-aos="fade-up"
      data-aos-delay="200"
    >
      Diseño web profesional, sistemas de fidelización y producción de contenido.
      Un equipo chileno dedicado a transformar su negocio digitalmente.
    </p>

    <!-- CTAs -->
    <div
      class="flex flex-col sm:flex-row gap-4 justify-center w-full max-w-sm sm:max-w-none mx-auto"
      data-aos="fade-up"
      data-aos-delay="300"
    >
      <a
        href="#contacto"
        class="bg-gradient-to-r from-brand-blue to-brand-purple text-white px-10 py-4 rounded-xl font-semibold hover:scale-105 active:scale-95 transition-transform duration-200 shadow-lg shadow-brand-blue/20 w-full sm:w-auto text-center"
      >
        Solicitar Cotización
      </a>
      <a
        href="#servicios"
        class="border border-brand-border text-brand-white px-10 py-4 rounded-xl font-semibold hover:border-brand-blue/40 hover:bg-brand-blue/5 active:bg-brand-blue/10 transition-all duration-200 w-full sm:w-auto text-center"
      >
        Ver Servicios
      </a>
    </div>

    <!-- Stats row -->
    <div
      class="mt-20 grid grid-cols-3 gap-8 max-w-md mx-auto"
      data-aos="fade-up"
      data-aos-delay="400"
    >
      <div class="text-center">
        <p class="text-3xl font-bold text-brand-white">5+</p>
        <p class="text-brand-muted text-xs mt-1 tracking-wide uppercase">Años de experiencia</p>
      </div>
      <div class="text-center border-x border-brand-border">
        <p class="text-3xl font-bold text-brand-white">60+</p>
        <p class="text-brand-muted text-xs mt-1 tracking-wide uppercase">Marcas atendidas</p>
      </div>
      <div class="text-center">
        <p class="text-3xl font-bold text-brand-white">3</p>
        <p class="text-brand-muted text-xs mt-1 tracking-wide uppercase">Servicios integrados</p>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce opacity-40">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class="w-5 h-5 text-brand-muted"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M19.5 8.25l-7.5 7.5-7.5-7.5"
      ></path>
    </svg>
  </div>
</section>
