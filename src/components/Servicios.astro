---
const services = [
  {
    n: '01',
    title: 'Sitios Web Profesionales',
    description: 'Desarrollo web a medida con diseño moderno y sistema de agendamiento integrado. Solución ideal para clínicas, salones, restaurantes y comercios locales.',
    features: ['Diseño 100% personalizado y responsive', 'Sistema de agendamiento en línea', 'Optimización SEO para Google'],
  },
  {
    n: '02',
    title: 'Fidelización Digital',
    description: 'Sistema de puntos y recompensas que fortalece la relación con tus clientes. Automatiza tu programa de lealtad y aumenta la frecuencia de visitas.',
    features: ['Programa de puntos y recompensas', 'App móvil para tus clientes', 'Notificaciones y campañas automáticas'],
  },
  {
    n: '03',
    title: 'Producción de Contenido',
    description: 'Fotografía, video y diseño gráfico ejecutado con estándares de calidad para posicionar tu marca en redes sociales y generar confianza.',
    features: ['Fotografía y video profesional', 'Diseño gráfico para redes sociales', 'Gestión y estrategia de contenido'],
  },
  {
    n: '04',
    title: 'Gestión de Meta Ads',
    description: 'Campañas en Facebook e Instagram diseñadas para atraer clientes reales. Estrategia, segmentación precisa y optimización continua para maximizar tu retorno.',
    features: ['Campañas en Facebook e Instagram', 'Segmentación por audiencia y zona', 'Reportes de resultados mensuales'],
  },
];
---

<section id="servicios" class="py-24 sm:py-36 px-6" style="background:#020202;">
  <div class="max-w-6xl mx-auto">

    <!-- Header editorial -->
    <div class="mb-16 sm:mb-24" data-aos="fade-up">
      <p class="text-brand-muted text-xs tracking-[0.22em] uppercase mb-5">Nuestros Servicios</p>
      <h2
        class="font-serif text-brand-white"
        style="font-size: clamp(36px, 4.5vw, 60px); font-weight: 400; line-height: 1.08; letter-spacing: -0.03em; max-width: 640px;"
      >
        Todo lo que necesita un negocio para crecer en digital.
      </h2>
    </div>

    <!-- Grid de servicios -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-brand-border">
      {services.map((s, i) => (
        <div
          class="bg-brand-black p-8 sm:p-10 group hover:bg-brand-dark transition-colors duration-300"
          data-aos="fade-up"
          data-aos-delay={i * 60}
        >
          <span class="text-brand-muted text-xs font-medium tracking-widest">{s.n}</span>
          <h3
            class="font-serif text-brand-white mt-4 mb-5"
            style="font-size: clamp(22px, 2vw, 28px); font-weight: 400; letter-spacing: -0.02em; line-height: 1.15;"
          >
            {s.title}
          </h3>
          <p class="text-brand-muted text-sm leading-relaxed mb-7">{s.description}</p>
          <ul class="space-y-2.5">
            {s.features.map(f => (
              <li class="flex items-center gap-3 text-xs text-brand-muted">
                <span class="w-1 h-1 rounded-full bg-brand-muted flex-shrink-0"></span>
                {f}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- CTA inferior -->
    <div class="mt-14 text-center" data-aos="fade-up">
      <a
        href="#contacto"
        class="inline-flex items-center gap-2 text-brand-muted hover:text-brand-white transition-colors text-sm"
      >
        Solicitar información detallada
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
