---
const base = Astro.url.pathname === '/' ? '' : '/';
---

<nav
  id="navbar"
  class="fixed top-0 w-full z-50 transition-all duration-300 py-5 px-6"
  style="padding-top: max(1.25rem, env(safe-area-inset-top));"
>
  <div class="max-w-6xl mx-auto flex items-center justify-between relative">

    <!-- Logo izquierda -->
    <a href="/" class="text-brand-white font-semibold text-lg tracking-tight flex-shrink-0">
      ReClub
    </a>

    <!-- Links centrados (desktop) — posición absoluta para centrado real -->
    <div class="hidden md:flex items-center gap-8 absolute left-1/2 -translate-x-1/2">
      <a href={`${base}#servicios`} class="text-brand-muted hover:text-brand-white transition-colors text-sm">Servicios</a>
      <a href={`${base}#por-que-reclub`} class="text-brand-muted hover:text-brand-white transition-colors text-sm">Por qué ReClub</a>
      <a href="/portafolio" class={`text-sm transition-colors ${Astro.url.pathname.startsWith('/portafolio') ? 'text-brand-white' : 'text-brand-muted hover:text-brand-white'}`}>Portafolio</a>
      <a href="/sistema-90" class={`text-sm transition-colors ${Astro.url.pathname === '/sistema-90' ? 'text-brand-white' : 'text-brand-muted hover:text-brand-white'}`}>Sistema 90</a>
    </div>

    <!-- CTA derecha -->
    <div class="flex items-center gap-3">
      <a
        href={`${base}#contacto`}
        class="hidden md:inline-flex text-brand-black bg-brand-white hover:bg-brand-blue-dark px-5 py-2.5 rounded-full text-sm font-semibold transition-colors"
      >
        Contáctenos
      </a>
      <!-- Mobile hamburger -->
      <button id="menu-btn" class="md:hidden text-brand-muted hover:text-brand-white transition-colors p-2" aria-label="Abrir menú">
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 hidden">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4 border-t border-brand-border">
    <div class="flex flex-col gap-4 pt-5 px-2">
      <a href={`${base}#servicios`} class="mobile-link text-brand-muted hover:text-brand-white transition-colors text-sm">Servicios</a>
      <a href={`${base}#por-que-reclub`} class="mobile-link text-brand-muted hover:text-brand-white transition-colors text-sm">Por qué ReClub</a>
      <a href="/portafolio" class="mobile-link text-brand-muted hover:text-brand-white transition-colors text-sm">Portafolio</a>
      <a href="/sistema-90" class="mobile-link text-brand-muted hover:text-brand-white transition-colors text-sm">Sistema 90</a>
      <a href={`${base}#contacto`} class="mobile-link mt-2 text-brand-black bg-brand-white text-center py-3 px-5 rounded-full font-semibold text-sm">Contáctenos</a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('navbar') as HTMLElement;
  const menuBtn = document.getElementById('menu-btn') as HTMLButtonElement;
  const mobileMenu = document.getElementById('mobile-menu') as HTMLElement;
  const iconOpen = document.getElementById('icon-open') as HTMLElement;
  const iconClose = document.getElementById('icon-close') as HTMLElement;

  window.addEventListener('scroll', () => {
    if (window.scrollY > 60) {
      nav.style.background = 'rgba(2,2,2,0.88)';
      nav.style.backdropFilter = 'blur(20px)';
      nav.style.borderBottom = '1px solid rgba(255,255,255,0.05)';
    } else {
      nav.style.background = '';
      nav.style.backdropFilter = '';
      nav.style.borderBottom = '';
    }
  });

  menuBtn?.addEventListener('click', () => {
    const isHidden = mobileMenu.classList.contains('hidden');
    mobileMenu.classList.toggle('hidden', !isHidden);
    iconOpen.classList.toggle('hidden', !isHidden);
    iconClose.classList.toggle('hidden', isHidden);
  });

  document.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
    });
  });
</script>
