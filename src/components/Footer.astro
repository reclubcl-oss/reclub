---
const base = Astro.url.pathname === '/' ? '' : '/';
---

<footer style="background:#020202; border-top: 1px solid #1C1C24; padding-bottom: env(safe-area-inset-bottom);">
  <div class="max-w-6xl mx-auto px-6 py-12 sm:py-16">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-8">

      <!-- Brand -->
      <div>
        <a href="/" class="text-brand-white font-semibold text-lg tracking-tight">ReClub</a>
        <p class="text-brand-muted text-xs mt-2 max-w-xs leading-relaxed">
          Agencia digital chilena. Diseño web, Meta Ads, fidelización y contenido para negocios que quieren crecer.
        </p>
      </div>

      <!-- Links -->
      <div class="flex flex-col sm:flex-row gap-4 sm:gap-10 text-sm text-brand-muted">
        <a href={`${base}#servicios`} class="hover:text-brand-white transition-colors">Servicios</a>
        <a href="/portafolio" class="hover:text-brand-white transition-colors">Portafolio</a>
        <a href="/sistema-90" class="hover:text-brand-white transition-colors">Sistema 90</a>
        <a href={`${base}#contacto`} class="hover:text-brand-white transition-colors">Contacto</a>
      </div>
    </div>

    <div class="mt-10 pt-8 border-t border-brand-border flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-brand-muted text-xs">© 2026 ReClub. Todos los derechos reservados.</p>
      <div class="flex items-center gap-4">
        <a href="https://wa.me/56938897621" target="_blank" rel="noopener noreferrer" class="text-brand-muted hover:text-brand-white transition-colors text-xs">+56 9 3889 7621</a>
        <a href="mailto:reclubcl@gmail.com" class="text-brand-muted hover:text-brand-white transition-colors text-xs">reclubcl@gmail.com</a>
      </div>
    </div>
  </div>
</footer>
