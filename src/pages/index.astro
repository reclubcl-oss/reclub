---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Servicios from '../components/Servicios.astro';
import PorQueReclub from '../components/PorQueReclub.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout
  title="ReClub — Agencia Digital · Santiago, Chile"
  description="Soluciones digitales integrales para negocios chilenos. Diseño web profesional, fidelización digital y producción de contenido. Contáctenos hoy."
>
  <Nav />
  <main>
    <Hero />
    <Servicios />
    <PorQueReclub />
    <Contacto />
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>
