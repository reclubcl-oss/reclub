---
import Layout from '../../layouts/Layout.astro';
import { getClientSession } from '../../lib/client-auth';

const session = await getClientSession(Astro.request);
if (session) return Astro.redirect('/panel');

const error = Astro.url.searchParams.get('error');
---

<Layout title="Acceder a mi panel — Sistema 90" noindex>
  <main class="min-h-screen bg-brand-black flex items-center justify-center px-6 py-16">
    <div class="w-full max-w-sm">
      <div class="text-center mb-10">
        <a href="/" class="text-brand-white font-semibold text-lg tracking-tight">ReClub</a>
        <p class="text-brand-muted text-xs tracking-[0.2em] uppercase mt-2 mb-8">Sistema 90</p>
        <h1 class="font-serif text-brand-white mb-2" style="font-size:28px;font-weight:400;letter-spacing:-0.02em;">Acceder a mi panel</h1>
        <p class="text-brand-muted text-sm">Te enviamos un enlace de acceso a tu correo.</p>
      </div>

      <div class="bg-brand-card border border-brand-border rounded-2xl p-6">
        {error === 'expired' && (
          <div class="mb-4 bg-red-500/10 border border-red-500/20 text-red-400 text-sm px-4 py-3 rounded-xl">
            El enlace expiró o ya fue usado. Solicita uno nuevo.
          </div>
        )}
        {error === 'invalid' && (
          <div class="mb-4 bg-red-500/10 border border-red-500/20 text-red-400 text-sm px-4 py-3 rounded-xl">
            Enlace inválido. Solicita uno nuevo.
          </div>
        )}
        <div id="successMsg" class="hidden mb-4 bg-green-500/10 border border-green-500/20 text-green-400 text-sm px-4 py-3 rounded-xl">
          ¡Listo! Revisa tu correo y haz clic en el enlace.
        </div>
        <form id="loginForm" class="space-y-4">
          <div>
            <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Correo electrónico</label>
            <input type="email" id="emailInput" required autocomplete="email"
              class="w-full bg-brand-dark border border-brand-border rounded-xl px-4 py-3 text-brand-white focus:border-brand-blue-dark outline-none transition-colors placeholder:text-brand-muted/40"
              placeholder="tu@clinica.cl"
            />
          </div>
          <button type="submit" id="submitBtn"
            class="w-full bg-brand-white text-brand-black font-semibold py-3 rounded-full hover:bg-brand-blue-dark transition-colors disabled:opacity-50"
          >Enviar enlace de acceso</button>
        </form>
      </div>

      <p class="text-center text-brand-muted text-xs mt-6">
        ¿Aún no eres cliente? <a href="/sistema-90" class="underline hover:text-brand-white">Conoce el Sistema 90</a>
      </p>
    </div>
  </main>
</Layout>

<script>
document.getElementById('loginForm')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = document.getElementById('submitBtn') as HTMLButtonElement;
  const email = (document.getElementById('emailInput') as HTMLInputElement).value;
  btn.disabled = true;
  btn.textContent = 'Enviando...';
  await fetch('/api/s90/auth/magic-link', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ email }),
  });
  document.getElementById('loginForm')!.classList.add('hidden');
  document.getElementById('successMsg')!.classList.remove('hidden');
});
</script>
