// ── CALENDAR ──
async function loadMonth() {
  const start = `${S.year}-${pad(S.month+1)}-01`;
  const last = new Date(S.year, S.month+1, 0).getDate();
  const end = `${S.year}-${pad(S.month+1)}-${pad(last)}`;
  const { data } = await supabase.from('bazit_content')
    .select('id,date,platform,title,publish_time,status')
    .gte('date',start).lte('date',end)
    .order('publish_time',{ascending:true});
  S.monthData = data||[];
  renderCal();
  await renderDayPane(S.selDate);
}

function renderCal() {
  const mn = document.getElementById('cal-month-name')!;
  const yn = document.getElementById('cal-year-num')!;
  mn.textContent = MONTHS[S.month];
  yn.textContent = String(S.year);

  const grid = document.getElementById('cal-grid')!;
  const today = todayStr();
  const startDow = (new Date(S.year, S.month, 1).getDay()+6)%7;
  const lastDay  = new Date(S.year, S.month+1, 0).getDate();

  // Group by date
  const byDate: Record<string,any[]> = {};
  S.monthData.forEach(i => { if(!byDate[i.date]) byDate[i.date]=[]; byDate[i.date].push(i); });

  let html = '';

  // Ghost cells before start
  for (let i=0; i<startDow; i++) html += `<div class="day-cell ghost"></div>`;

  for (let d=1; d<=lastDay; d++) {
    const ds = `${S.year}-${pad(S.month+1)}-${pad(d)}`;
    const items = byDate[ds]||[];
    const isToday = ds===today;
    const isSel   = ds===S.selDate;

    const numCls = isToday ? 'day-num is-today' : isSel ? 'day-num is-sel' : 'day-num';
    const cellCls = ['day-cell', items.length?'has-ev':'', isSel?'sel':''].filter(Boolean).join(' ');

    // Event blocks (max 3)
    const evHtml = items.slice(0,3).map(item => {
      const p = PC[item.platform] || { short:item.platform, color:'rgba(255,255,255,0.5)', bg:'rgba(255,255,255,0.08)', bar:'#666' };
      const time = item.publish_time ? item.publish_time.slice(0,5) : '';
      return `<div class="ev-block" style="background:${p.bg};border-left-color:${p.bar};">
        <span class="ev-time" style="color:${p.color};">${time}</span>
        <span class="ev-text" style="color:${p.color};">${esc(p.short)}</span>
      </div>`;
    }).join('');
    const more = items.length>3 ? `<div class="ev-more">+${items.length-3} más</div>` : '';

    html += `<div class="${cellCls}" onclick="selectDay('${ds}')">
      <div class="${numCls}">${d}</div>
      ${evHtml}${more}
    </div>`;
  }

  // Fill remainder
  const total = startDow + lastDay;
  const rem = total%7===0 ? 0 : 7-(total%7);
  for (let i=0; i<rem; i++) html += `<div class="day-cell ghost"></div>`;

  grid.innerHTML = html;

  // Stat
  const stat = document.getElementById('cal-stat')!;
  const n = S.monthData.length;
  if (n>0) { stat.textContent = `${n} publicación${n!==1?'es':''}`; stat.style.display=''; }
  else stat.style.display='none';
}

// ── SELECT DAY ──
(window as any).selectDay = function(ds: string) {
  S.selDate = ds;
  renderCal();
  // Mobile: open sheet
  if (window.innerWidth < 1024) {
    openMobSheet(ds);
  } else {
    renderDayPane(ds);
  }
};

// ── DAY PANE (desktop) ──
async function renderDayPane(ds: string) {
  const [y,m,d] = ds.split('-').map(Number);
  const dow = DAYS3[new Date(y,m-1,d).getDay()];

  const dpDow  = document.getElementById('dp-dow')!;
  const dpDate = document.getElementById('dp-date')!;
  const dpYear = document.getElementById('dp-year')!;
  const dpCount= document.getElementById('dp-count')!;
  const dpBody = document.getElementById('dp-body')!;

  dpDow.textContent  = dow;
  dpDate.textContent = `${d} de ${MONTHS[m-1]}`;
  dpYear.textContent = String(y);
  dpBody.innerHTML   = '<div class="empty-state"><div class="empty-msg">Cargando...</div></div>';
  dpCount.style.display = 'none';

  const { data: items } = await supabase.from('bazit_content').select('*').eq('date',ds).order('publish_time',{ascending:true});

  if (!items || !items.length) {
    dpBody.innerHTML = `<div class="empty-state">
      <div class="empty-icon"><svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="rgba(255,255,255,0.3)"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg></div>
      <div class="empty-msg">Sin publicaciones</div>
      <div class="empty-sub">Agrega el primer contenido del día</div>
    </div>`;
    return;
  }

  dpCount.innerHTML = `<svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg> ${items.length} publicación${items.length!==1?'es':''}`;
  dpCount.style.display = 'inline-flex';

  dpBody.innerHTML = buildCards(items);
}

function buildCards(items: any[]) {
  return items.map(item => {
    const p = PC[item.platform]||{ short:item.platform, color:'rgba(255,255,255,0.5)', bg:'rgba(255,255,255,0.06)', bar:'#555' };
    const s = SC[item.status]||SC.pendiente;
    const time = item.publish_time ? item.publish_time.slice(0,5) : null;
    const itemJson = JSON.stringify(item).replace(/"/g,'&quot;');

    return `<div class="ev-card">
      <div class="ev-card-top">
        <div class="ev-card-bar" style="background:${p.bar};border-radius:14px 0 0 ${item.caption||item.script||item.notes?'0':'14px'};"></div>
        <div class="ev-card-body">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:7px;">
            <span class="ev-platform" style="color:${p.color}">${esc(p.short)}</span>
            <span class="badge ${s.cls}">${s.label}</span>
          </div>
          <div class="ev-title">${esc(item.title)}</div>
          ${time ? `<div class="ev-time-row">${time} hrs</div>` : ''}
        </div>
      </div>
      ${item.caption ? `<div class="ev-caption">${esc(item.caption)}</div>` : ''}
      ${item.script ? `
        <details class="ev-script">
          <summary>
            <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
            Ver guión completo
          </summary>
          <pre class="ev-script-body">${esc(item.script)}</pre>
        </details>
      ` : ''}
      ${item.notes ? `<div class="ev-notes">${esc(item.notes)}</div>` : ''}
      <div class="ev-actions">
        <button class="ev-action" onclick="editContent(${itemJson})">Editar</button>
        <div class="ev-action-sep"></div>
        <button class="ev-action del" onclick="delContent('${item.id}','${item.date}')">Eliminar</button>
      </div>
    </div>`;
  }).join('');
}

