    return `<div class="imp-card">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:6px;">
        <p style="font-size:13.5px;font-weight:500;color:${done?'rgba(255,255,255,0.3)':'rgba(255,255,255,0.88)'};${done?'text-decoration:line-through':''};line-height:1.4;">${esc(imp.title)}</p>
        <span class="badge ${s.cls}">${s.label}</span>
      </div>
      ${imp.description?`<p style="font-size:12px;color:rgba(255,255,255,0.4);line-height:1.5;margin-bottom:10px;">${esc(imp.description)}</p>`:''}
      <div style="display:flex;align-items:center;justify-content:space-between;margin-top:8px;">
        <span class="badge ${c.cls}">${c.label}</span>
        <div style="display:flex;gap:5px;">
          <button onclick="openModal('improvement',${JSON.stringify(imp).replace(/"/g,'&quot;')})" style="font-size:11.5px;color:rgba(255,255,255,0.3);background:none;border:1px solid rgba(255,255,255,0.08);border-radius:7px;padding:4px 11px;cursor:pointer;min-height:auto;transition:all 0.15s;font-family:var(--font);" onmouseover="this.style.color='rgba(255,255,255,0.7)';this.style.borderColor='rgba(255,255,255,0.18)'" onmouseout="this.style.color='rgba(255,255,255,0.3)';this.style.borderColor='rgba(255,255,255,0.08)'">Editar</button>
          <button onclick="delImpr('${imp.id}')" style="font-size:11.5px;color:rgba(248,113,113,0.35);background:none;border:1px solid rgba(248,113,113,0.12);border-radius:7px;padding:4px 11px;cursor:pointer;min-height:auto;transition:all 0.15s;font-family:var(--font);" onmouseover="this.style.color='#f87171';this.style.borderColor='rgba(248,113,113,0.3)'" onmouseout="this.style.color='rgba(248,113,113,0.35)';this.style.borderColor='rgba(248,113,113,0.12)'">Eliminar</button>
        </div>
      </div>
    </div>`;
  }).join('');
}

(window as any).delImpr = async function(id: string) {
  if (!confirm('¿Eliminar mejora?')) return;
  await supabase.from('bazit_improvements').delete().eq('id',id);
  loadImprs();
};

document.getElementById('form-improvement')?.addEventListener('submit', async e => {
  e.preventDefault();
  const btn = document.getElementById('fi-save') as HTMLButtonElement;
  btn.textContent='Guardando...'; btn.disabled=true;
  const id = (document.getElementById('fi-id') as HTMLInputElement).value;
  const payload = {
    title: (document.getElementById('fi-title') as HTMLInputElement).value,
    description: (document.getElementById('fi-desc') as HTMLTextAreaElement).value||null,
    category: (document.getElementById('fi-cat') as HTMLSelectElement).value,
    status: (document.getElementById('fi-status') as HTMLSelectElement).value,
  };
  if (id) await supabase.from('bazit_improvements').update(payload).eq('id',id);
  else    await supabase.from('bazit_improvements').insert(payload);
  (window as any).closeModal('improvement');
  loadImprs();
  btn.textContent='Guardar'; btn.disabled=false;
});

(window as any).setImprFilter = function(btn: HTMLElement, f: string) {
  S.imprFilter = f;
  document.querySelectorAll('#impr-filters .ftab').forEach(b => { b.className='ftab'; });
  btn.className = 'ftab fp'; loadImprs();
};

// ── LOGOUT ──
const logout = async () => { await supabase.auth.signOut(); window.location.href='/bazit'; };
document.getElementById('logout-btn')?.addEventListener('click', logout);
document.getElementById('logout-mob')?.addEventListener('click', logout);

// ── MONTH NAV ──
document.getElementById('prev-month')?.addEventListener('click', () => {
  if (S.month===0) { S.month=11; S.year--; } else S.month--;
  loadMonth();
});
document.getElementById('next-month')?.addEventListener('click', () => {
  if (S.month===11) { S.month=0; S.year++; } else S.month++;
  loadMonth();
});
document.getElementById('today-btn')?.addEventListener('click', () => {
  S.year=new Date().getFullYear(); S.month=new Date().getMonth();
  S.selDate=todayStr();
  loadMonth();
});

// ── THEME ──
const appEl     = document.querySelector('.app') as HTMLElement;
const themePill = document.getElementById('theme-pill')!;
const themeText = document.getElementById('theme-text')!;
const iconSun   = document.getElementById('theme-icon-sun')!;
const iconMoon  = document.getElementById('theme-icon-moon')!;

function applyTheme(light: boolean) {
  appEl.dataset.theme = light ? 'light' : 'dark';
  themePill.classList.toggle('on', light);
  themeText.textContent = light ? 'Modo oscuro' : 'Modo claro';
  (iconSun  as HTMLElement).style.display = light ? '' : 'none';
  (iconMoon as HTMLElement).style.display = light ? 'none' : '';
  localStorage.setItem('bazit-theme', light ? 'light' : 'dark');
}

const savedTheme = localStorage.getItem('bazit-theme');
applyTheme(savedTheme === 'light');

document.getElementById('theme-toggle')?.addEventListener('click', () => {
  applyTheme(appEl.dataset.theme !== 'light');
});

// ── INIT ──
const calView = document.getElementById('view-calendar')!;
calView.style.display = '';
document.getElementById('day-pane')!.style.display = '';

loadMonth();
</script>
