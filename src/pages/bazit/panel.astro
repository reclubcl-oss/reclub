};

function todayStr() {
  const d = new Date();
  return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
}
function pad(n:number) { return String(n).padStart(2,'0'); }
function esc(s:string) { return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function fmtDate(s:string) {
  const [y,m,d] = s.split('-').map(Number);
  return `${d} ${MONTHS[m-1].slice(0,3)} ${y}`;
}

// ── VIEW SWITCHING ──
(window as any).setView = function(view: string) {
  S.view = view;
  // Calendar view
  const cv = document.getElementById('view-calendar')!;
  cv.classList.toggle('cal-view', view==='calendar');
  cv.classList.toggle('hidden', view!=='calendar');
  if (view==='calendar') cv.style.display='';

  document.getElementById('view-tasks')!.classList.toggle('show', view==='tasks');
  document.getElementById('view-improvements')!.classList.toggle('show', view==='improvements');

  // Day panel only visible in calendar
  const dp = document.getElementById('day-pane')!;
  dp.style.display = view==='calendar' ? '' : 'none';

  // Nav buttons
  document.querySelectorAll('.sb-btn, .mob-tab').forEach(b => {
    b.classList.toggle('on', (b as HTMLElement).dataset.view === view);
  });

  const labels: Record<string,string> = { calendar:'Calendario', tasks:'Tareas', improvements:'Mejoras' };
  const lbl = document.getElementById('mob-view-label');
