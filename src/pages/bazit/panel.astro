---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Panel Bazit — Gestión de Contenido">
<style>
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

:root {
  --bg:        #070710;
  --bg2:       #0c0c1c;
  --bg3:       #101022;
  --card:      #13132a;
  --border:    rgba(255,255,255,0.055);
  --border2:   rgba(255,255,255,0.10);
  --text:      #e8e8f8;
  --muted:     rgba(232,232,248,0.42);
  --dim:       rgba(232,232,248,0.22);
  --green:     #10b981;
  --green2:    #059669;
  --green-glow:rgba(16,185,129,0.4);
  --font:      'Poppins', system-ui, sans-serif;
}

/* ─── LIGHT THEME ─── */
.app[data-theme="light"] {
  --bg:        #f0f2f9;
  --bg2:       #ffffff;
  --bg3:       #f7f8fc;
  --card:      #ffffff;
  --border:    rgba(0,0,0,0.07);
  --border2:   rgba(0,0,0,0.13);
  --text:      #0f0f1e;
  --muted:     rgba(15,15,30,0.5);
  --dim:       rgba(15,15,30,0.32);
  --green-glow:rgba(16,185,129,0.25);
}
.app[data-theme="light"] .cal-dow { background: var(--bg3); }
.app[data-theme="light"] .day-cell:hover { background: rgba(0,0,0,0.025); }
.app[data-theme="light"] .day-cell.has-ev { background: rgba(16,185,129,0.04); }
.app[data-theme="light"] .day-cell.has-ev:hover { background: rgba(16,185,129,0.08); }
.app[data-theme="light"] .day-cell.sel { background: rgba(16,185,129,0.1) !important; }
.app[data-theme="light"] .modal-box { background: #ffffff; border-color: rgba(0,0,0,0.1); }
.app[data-theme="light"] .modal-head { background: #ffffff; }
.app[data-theme="light"] .finput { background: rgba(0,0,0,0.04); border-color: rgba(0,0,0,0.1); color: var(--text); }
.app[data-theme="light"] .finput:focus { background: rgba(16,185,129,0.04); border-color: rgba(16,185,129,0.5); }
.app[data-theme="light"] .finput::placeholder { color: rgba(0,0,0,0.25); }
.app[data-theme="light"] select.finput { background: rgba(0,0,0,0.04); }
.app[data-theme="light"] .mob-nav { background: rgba(255,255,255,0.97); }
.app[data-theme="light"] .mob-sheet-box { background: var(--bg2); }

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

/* ─── ROOT ─── */
.app {
  display: flex;
  height: 100vh;
  width: 100vw;
  overflow: hidden;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font);
  font-size: 14px;
  -webkit-font-smoothing: antialiased;
}

/* ─── SIDEBAR ─── */
.sidebar {
  width: 228px;
  flex-shrink: 0;
  background: var(--bg2);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.sb-brand { padding: 26px 20px 22px; border-bottom: 1px solid var(--border); }
.sb-reclub { font-size: 11px; font-weight: 600; letter-spacing: 0.06em; color: var(--dim); text-decoration: none; }
.sb-reclub b { color: #3b82f6; font-weight: 700; }
.sb-client { display: flex; align-items: center; gap: 11px; margin-top: 18px; }
.sb-avatar {
  width: 40px; height: 40px; border-radius: 12px; flex-shrink: 0;
  background: linear-gradient(135deg, var(--green), var(--green2));
  display: flex; align-items: center; justify-content: center;
  font-weight: 800; font-size: 16px; color: #fff;
  box-shadow: 0 4px 16px rgba(16,185,129,0.3);
}
.sb-name { font-size: 15px; font-weight: 600; line-height: 1.2; }
.sb-sub  { font-size: 11px; color: var(--dim); margin-top: 2px; }

.sb-nav { flex: 1; padding: 12px 10px; display: flex; flex-direction: column; gap: 2px; }
.sb-btn {
  display: flex; align-items: center; gap: 11px;
  padding: 10px 13px; border-radius: 10px;
  font-size: 13.5px; font-weight: 500; color: var(--muted);
  background: none; border: none; cursor: pointer; width: 100%;
  transition: all 0.15s; position: relative; font-family: var(--font);
  min-height: auto;
}
.sb-btn:hover { color: var(--text); background: rgba(255,255,255,0.04); }
.sb-btn.on { color: var(--text); background: rgba(16,185,129,0.1); }
.sb-btn.on::before {
  content: ''; position: absolute; left: 0; top: 8px; bottom: 8px;
  width: 3px; background: var(--green); border-radius: 0 3px 3px 0;
}
.sb-badge {
  margin-left: auto; padding: 1px 7px; border-radius: 20px;
  font-size: 10px; font-weight: 600;
  background: rgba(245,158,11,0.15); color: #f59e0b;
}

.sb-foot { padding: 12px 10px; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 4px; }
.sb-theme {
  display: flex; align-items: center; justify-content: space-between;
  padding: 9px 13px; border-radius: 10px;
  font-size: 13px; font-weight: 500; color: var(--muted);
  width: 100%; font-family: var(--font); min-height: auto;
  border: none; background: none; cursor: pointer; transition: all 0.15s;
}
.sb-theme:hover { color: var(--text); background: rgba(128,128,128,0.08); }
.theme-pill {
  width: 38px; height: 21px; border-radius: 20px;
  background: rgba(128,128,128,0.2); position: relative;
  transition: background 0.22s; flex-shrink: 0; pointer-events: none;
}
.theme-pill.on { background: var(--green); }
.theme-pill::after {
  content: ''; position: absolute; top: 3px; left: 3px;
  width: 15px; height: 15px; border-radius: 50%;
  background: #fff; transition: transform 0.22s;
  box-shadow: 0 1px 4px rgba(0,0,0,0.25);
}
.theme-pill.on::after { transform: translateX(17px); }
.sb-logout {
  display: flex; align-items: center; gap: 9px; width: 100%;
  padding: 9px 13px; border-radius: 10px;
  font-size: 13px; font-weight: 500; color: var(--dim);
  background: none; border: none; cursor: pointer;
  transition: all 0.15s; font-family: var(--font); min-height: auto;
}
.sb-logout:hover { color: var(--muted); background: rgba(255,255,255,0.04); }

/* ─── MAIN AREA ─── */
.main { flex: 1; display: flex; flex-direction: column; overflow: hidden; min-width: 0; }

/* ─── MOBILE HEADER ─── */
.mob-header {
  display: none; align-items: center; justify-content: space-between;
  padding: 14px 18px; border-bottom: 1px solid var(--border);
  background: var(--bg2); flex-shrink: 0;
}
@media (max-width: 1023px) {
  .sidebar { display: none; }
  .mob-header { display: flex; }
  .day-pane { display: none !important; }
}

/* ─── VIEWS CONTAINER ─── */
.views { flex: 1; display: flex; overflow: hidden; }

/* ─── CALENDAR VIEW ─── */
.cal-view {
  flex: 1; display: flex; flex-direction: column; overflow: hidden;
  padding: 24px 24px 0;
}
.cal-view.hidden { display: none; }

.cal-topbar {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 20px; flex-shrink: 0;
}
.cal-left { display: flex; align-items: baseline; gap: 10px; }
.cal-month-name { font-size: 24px; font-weight: 700; letter-spacing: -0.03em; }
.cal-year-num   { font-size: 24px; font-weight: 300; color: var(--dim); }
.cal-right { display: flex; align-items: center; gap: 8px; }
.cal-nav {
  width: 32px; height: 32px; border-radius: 50%;
  border: 1px solid var(--border2); background: none;
  display: flex; align-items: center; justify-content: center;
  color: var(--muted); cursor: pointer; transition: all 0.15s; min-height: auto;
}
.cal-nav:hover { border-color: var(--green); color: var(--green); background: rgba(16,185,129,0.08); }
.cal-today {
  padding: 6px 16px; border-radius: 8px;
  border: 1px solid var(--border2); background: none;
  font-size: 12.5px; font-weight: 500; color: var(--muted);
  cursor: pointer; transition: all 0.15s; font-family: var(--font); min-height: auto;
}
.cal-today:hover { border-color: var(--green); color: var(--green); background: rgba(16,185,129,0.08); }
.cal-stat {
  font-size: 12px; color: var(--dim);
  background: rgba(255,255,255,0.04);
  padding: 5px 12px; border-radius: 20px;
}

/* Calendar outer box */
.cal-box {
  flex: 1; display: flex; flex-direction: column;
  border: 1px solid var(--border);
  border-radius: 16px 16px 0 0;
  overflow: hidden;
  min-height: 0;
}

/* Day-of-week header */
.cal-dow {
  display: grid; grid-template-columns: repeat(7,1fr);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
  background: var(--bg2);
}
.cal-dow-cell {
  text-align: center; padding: 13px 0;
  font-size: 11px; font-weight: 600;
  letter-spacing: 0.09em; text-transform: uppercase;
  color: var(--dim);
}

/* The grid itself — fills remaining height */
.cal-grid {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(7,1fr);
  grid-auto-rows: 1fr;
  min-height: 0;
  overflow: hidden;
}

/* Individual day cell */
.day-cell {
  border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  padding: 10px 10px 8px;
  cursor: pointer;
  transition: background 0.12s;
  display: flex;
  flex-direction: column;
  gap: 3px;
  overflow: hidden;
  min-height: 0;
}
.day-cell:nth-child(7n)         { border-right: none; }
.day-cell:hover                 { background: rgba(255,255,255,0.025); }
.day-cell.has-ev                { background: rgba(16,185,129,0.025); }
.day-cell.has-ev:hover          { background: rgba(16,185,129,0.05); }
.day-cell.sel                   { background: rgba(16,185,129,0.07) !important; outline: 1.5px inset rgba(16,185,129,0.3); }
.day-cell.ghost                 { opacity: 0.15; pointer-events: none; }

.day-num {
  font-size: 13px; font-weight: 500; color: rgba(255,255,255,0.55);
  width: 28px; height: 28px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; line-height: 1;
}
.day-num.is-today {
  background: var(--green); color: #fff; font-weight: 700;
  box-shadow: 0 0 14px var(--green-glow);
}
.day-num.is-sel { color: #6ee7b7; font-weight: 600; }

/* Event block inside cell */
.ev-block {
  display: flex; align-items: center; gap: 5px;
  padding: 3px 7px 3px 5px;
  border-radius: 6px;
  font-size: 11px; font-weight: 500;
  white-space: nowrap; overflow: hidden;
  border-left: 3px solid transparent;
  flex-shrink: 0;
  line-height: 1.3;
}
.ev-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
.ev-time { font-size: 10px; font-weight: 600; opacity: 0.7; flex-shrink: 0; }
.ev-more { font-size: 10px; color: var(--dim); padding: 2px 5px; }

/* ─── DAY PANEL (always-on right column in calendar view) ─── */
.day-pane {
  width: 360px; flex-shrink: 0;
  background: var(--bg2);
  border-left: 1px solid var(--border);
  display: flex; flex-direction: column;
  overflow: hidden;
}
.dp-head {
  padding: 28px 22px 22px;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
  background: linear-gradient(160deg, rgba(16,185,129,0.09) 0%, transparent 60%);
}
.dp-dow  { font-size: 11px; font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; color: var(--green); margin-bottom: 6px; }
.dp-date { font-size: 28px; font-weight: 700; letter-spacing: -0.04em; line-height: 1; }
.dp-year { font-size: 13px; color: var(--dim); margin-top: 4px; }
.dp-count{ display: inline-flex; align-items: center; gap: 5px; margin-top: 12px; font-size: 12px; color: var(--muted); background: rgba(255,255,255,0.05); padding: 4px 10px; border-radius: 20px; }

.dp-body  { flex: 1; overflow-y: auto; padding: 16px 16px 8px; }
.dp-foot  { padding: 14px 16px; border-top: 1px solid var(--border); flex-shrink: 0; }

/* Content cards */
.ev-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 14px;
  overflow: hidden;
  margin-bottom: 10px;
  transition: border-color 0.15s;
}
.ev-card:hover { border-color: var(--border2); }
.ev-card-top {
  display: flex; gap: 0;
}
.ev-card-bar { width: 4px; flex-shrink: 0; border-radius: 14px 0 0 0; }
.ev-card-body { flex: 1; padding: 13px 14px 12px; min-width: 0; }
.ev-platform { font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 6px; }
.ev-title { font-size: 13.5px; font-weight: 500; color: rgba(255,255,255,0.88); line-height: 1.4; margin-bottom: 4px; }
.ev-time-row { font-size: 12px; color: var(--dim); }
.ev-caption { font-size: 12px; color: var(--muted); line-height: 1.5; padding: 10px 14px; border-top: 1px solid var(--border); }

details.ev-script > summary {
  display: flex; align-items: center; gap: 6px;
  padding: 9px 14px; font-size: 11.5px; color: var(--dim);
  cursor: pointer; list-style: none; border-top: 1px solid var(--border);
  transition: color 0.15s;
}
details.ev-script > summary:hover { color: var(--muted); }
details.ev-script > summary::marker,
details.ev-script > summary::-webkit-details-marker { display: none; }
.ev-script-body {
  padding: 0 14px 14px;
  font-size: 12px; color: var(--muted); line-height: 1.7;
  white-space: pre-wrap; font-family: var(--font);
}
.ev-notes { padding: 8px 14px; font-size: 11px; color: var(--dim); font-style: italic; border-top: 1px solid var(--border); }
.ev-actions { display: flex; border-top: 1px solid var(--border); }
.ev-action {
  flex: 1; padding: 9px; font-size: 11.5px; font-weight: 500;
  color: var(--dim); background: none; border: none; cursor: pointer;
  transition: all 0.15s; font-family: var(--font); min-height: auto;
}
.ev-action:hover { color: var(--text); background: rgba(255,255,255,0.04); }
.ev-action.del:hover { color: #f87171; background: rgba(248,113,113,0.06); }
.ev-action-sep { width: 1px; background: var(--border); }

/* ─── TASKS / IMPROVEMENTS VIEWS ─── */
.list-view {
  flex: 1; overflow-y: auto;
  padding: 32px 32px 56px;
  display: none;
}
.list-view.show { display: block; }

.lv-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28px; }
.lv-title { font-size: 26px; font-weight: 700; letter-spacing: -0.03em; }
.lv-sub   { font-size: 13px; color: var(--dim); margin-top: 3px; }

.filters { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 22px; }
.ftab {
  padding: 6px 16px; border-radius: 8px;
  border: 1px solid var(--border); background: none;
  font-size: 12.5px; font-weight: 500; color: var(--muted);
  cursor: pointer; transition: all 0.15s; font-family: var(--font); min-height: auto;
}
.ftab:hover { color: var(--text); border-color: var(--border2); }
.ftab.fa { background: rgba(245,158,11,0.1); color: #f59e0b; border-color: rgba(245,158,11,0.2); }
.ftab.fp { background: rgba(139,92,246,0.1); color: #a78bfa; border-color: rgba(139,92,246,0.2); }
.ftab.fg { background: rgba(16,185,129,0.1); color: #34d399; border-color: rgba(16,185,129,0.2); }

/* Task card */
.task-card {
  display: flex; align-items: flex-start; gap: 13px;
  padding: 15px 16px; background: var(--bg3);
  border: 1px solid var(--border); border-radius: 14px;
  margin-bottom: 8px; transition: border-color 0.15s;
}
.task-card:hover { border-color: var(--border2); }
.tc-check {
  width: 20px; height: 20px; border-radius: 50%;
  border: 2px solid rgba(255,255,255,0.15); flex-shrink: 0; margin-top: 1px;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; background: none; transition: all 0.15s; min-height: auto;
}
.tc-check.done { background: var(--green); border-color: var(--green); }
.tc-check:not(.done):hover { border-color: rgba(16,185,129,0.5); }
.tc-title { font-size: 13.5px; font-weight: 500; line-height: 1.4; }
.tc-title.done { text-decoration: line-through; color: var(--dim); }
.tc-desc  { font-size: 12px; color: var(--muted); margin-top: 4px; line-height: 1.5; }
.tc-meta  { display: flex; align-items: center; gap: 10px; margin-top: 7px; }

/* Improve card */
.imp-card {
  padding: 15px 16px; background: var(--bg3);
  border: 1px solid var(--border); border-radius: 14px;
  margin-bottom: 8px; transition: border-color 0.15s;
}
.imp-card:hover { border-color: var(--border2); }

/* ─── BADGES ─── */
.badge { display: inline-flex; align-items: center; padding: 2px 9px; border-radius: 20px; font-size: 11px; font-weight: 500; }
.b-pend { background: rgba(245,158,11,0.12); color: #f59e0b;  border: 1px solid rgba(245,158,11,0.2); }
.b-prog { background: rgba(59,130,246,0.12);  color: #60a5fa;  border: 1px solid rgba(59,130,246,0.2); }
.b-done { background: rgba(16,185,129,0.12);  color: #34d399;  border: 1px solid rgba(16,185,129,0.2); }
.b-film { background: rgba(14,165,233,0.12);  color: #38bdf8;  border: 1px solid rgba(14,165,233,0.2); }
.b-edit { background: rgba(139,92,246,0.12);  color: #a78bfa;  border: 1px solid rgba(139,92,246,0.2); }
.b-pub  { background: rgba(16,185,129,0.12);  color: #34d399;  border: 1px solid rgba(16,185,129,0.2); }
.b-c { background: rgba(236,72,153,0.1);  color: #f472b6; border: 1px solid rgba(236,72,153,0.15); }
.b-d { background: rgba(139,92,246,0.1);  color: #a78bfa; border: 1px solid rgba(139,92,246,0.15); }
.b-e { background: rgba(59,130,246,0.1);  color: #60a5fa; border: 1px solid rgba(59,130,246,0.15); }
.b-p { background: rgba(245,158,11,0.1);  color: #fbbf24; border: 1px solid rgba(245,158,11,0.15); }
.b-o { background: rgba(255,255,255,0.06); color: var(--muted); border: 1px solid var(--border); }

/* ─── BUTTONS ─── */
.btn-green {
  display: flex; align-items: center; justify-content: center; gap: 8px;
  background: var(--green); color: #fff;
  font-size: 13.5px; font-weight: 600; border: none; border-radius: 11px;
  padding: 11px 18px; cursor: pointer; transition: all 0.15s;
  font-family: var(--font); width: 100%; min-height: auto;
}
.btn-green:hover { background: var(--green2); }
.btn-green:active { transform: scale(0.98); }
.btn-add {
  display: flex; align-items: center; gap: 7px;
  background: var(--green); color: #fff;
  font-size: 13px; font-weight: 600; border: none; border-radius: 10px;
  padding: 9px 18px; cursor: pointer; transition: all 0.15s;
  font-family: var(--font); min-height: auto;
}
.btn-add:hover { background: var(--green2); }
.btn-cancel {
  flex: 1; background: rgba(255,255,255,0.06); color: var(--muted);
  font-size: 14px; font-weight: 500; border: 1px solid var(--border);
  border-radius: 11px; padding: 12px; cursor: pointer;
  transition: all 0.15s; font-family: var(--font); min-height: auto;
}
.btn-cancel:hover { background: rgba(255,255,255,0.1); color: var(--text); }
.btn-save {
  flex: 1.5; background: var(--green); color: #fff;
  font-size: 14px; font-weight: 600; border: none;
  border-radius: 11px; padding: 12px; cursor: pointer;
  transition: all 0.15s; font-family: var(--font); min-height: auto;
}
.btn-save:hover { background: var(--green2); }

/* ─── MODALS ─── */
.modal {
  position: fixed; inset: 0;
  display: none; align-items: flex-end; justify-content: center;
  z-index: 60;
}
@media (min-width: 1024px) { .modal { align-items: center; padding: 16px; } }
.modal.open { display: flex; }
.modal-bg { position: absolute; inset: 0; background: rgba(0,0,0,0.82); backdrop-filter: blur(8px); }
.modal-box {
  position: relative; background: #141428;
  border: 1px solid rgba(255,255,255,0.09);
  border-radius: 22px 22px 0 0; width: 100%;
  max-height: 94vh; overflow-y: auto;
}
@media (min-width: 1024px) { .modal-box { border-radius: 18px; max-width: 500px; } }
.modal-head {
  position: sticky; top: 0; background: #141428;
  display: flex; align-items: center; justify-content: space-between;
  padding: 20px 22px; border-bottom: 1px solid var(--border);
}
.modal-title { font-size: 16px; font-weight: 700; }
.modal-x {
  width: 30px; height: 30px; border-radius: 8px;
  background: rgba(255,255,255,0.07); border: none;
  display: flex; align-items: center; justify-content: center;
  color: var(--muted); cursor: pointer; transition: all 0.15s; min-height: auto;
}
.modal-x:hover { background: rgba(255,255,255,0.12); color: var(--text); }
.modal-form { padding: 22px; display: flex; flex-direction: column; gap: 16px; }
.f2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.flabel { display: block; font-size: 10.5px; font-weight: 600; color: var(--dim); text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 7px; }
.finput {
  width: 100%; background: rgba(255,255,255,0.05); border: 1px solid var(--border);
  border-radius: 11px; padding: 11px 14px; color: var(--text);
  font-size: 14px; outline: none; transition: border-color 0.15s;
  font-family: var(--font); -webkit-appearance: none;
}
.finput:focus { border-color: rgba(16,185,129,0.55); background: rgba(16,185,129,0.04); }
.finput::placeholder { color: rgba(255,255,255,0.2); }
select.finput { background: rgba(255,255,255,0.05); }
textarea.finput { resize: none; }
.frow { display: flex; gap: 10px; margin-top: 4px; }

/* ─── EMPTY STATE ─── */
.empty-state { text-align: center; padding: 44px 24px; }
.empty-icon { width: 48px; height: 48px; border-radius: 14px; background: rgba(255,255,255,0.04); display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; }
.empty-msg  { font-size: 13.5px; color: var(--muted); }
.empty-sub  { font-size: 12px; color: var(--dim); margin-top: 4px; }

/* ─── MOBILE BOTTOM NAV ─── */
.mob-nav {
  display: none; position: fixed; bottom: 0; left: 0; right: 0;
  background: rgba(12,12,28,0.97); backdrop-filter: blur(12px);
  border-top: 1px solid var(--border); z-index: 30;
}
.mob-tab {
  flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px;
  padding: 11px 0 13px; color: var(--dim);
  background: none; border: none; cursor: pointer;
  font-size: 10px; font-weight: 500; font-family: var(--font);
  transition: color 0.15s; min-height: auto;
}
.mob-tab.on { color: var(--green); }
@media (max-width: 1023px) {
  .mob-nav { display: flex; }
  .main { padding-bottom: 64px; }
}

/* ─── SCROLLBAR ─── */
::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 4px; }

/* ─── PRIORITY ─── */
