<script>
import { supabase } from '../../lib/supabase-browser';

// ── AUTH ──
const { data: { session } } = await supabase.auth.getSession();
if (!session) { window.location.href = '/bazit'; }

// ── STATE ──
const S = {
  year: new Date().getFullYear(),
  month: new Date().getMonth(),
  view: 'calendar',
  selDate: todayStr(),
  monthData: [] as any[],
  tasks: [] as any[],
  taskFilter: 'pendiente',
  imprs: [] as any[],
  imprFilter: 'all',
  editContent: null as any,
  editTask: null as any,
  editImpr: null as any,
};

const MONTHS = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
const DAYS3  = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];

// Platform config
const PC: Record<string,{ short:string; color:string; bg:string; bar:string }> = {
  instagram_reel:  { short:'IG Reel',  color:'#f472b6', bg:'rgba(244,114,182,0.14)', bar:'#ec4899' },
  instagram_post:  { short:'IG Post',  color:'#f9a8d4', bg:'rgba(249,168,212,0.12)', bar:'#ec4899' },
  instagram_story: { short:'IG Story', color:'#c084fc', bg:'rgba(192,132,252,0.13)', bar:'#a855f7' },
