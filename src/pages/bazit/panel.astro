(window as any).openModal = function(type: string, data?: any) {
  if (type==='content') {
    document.getElementById('mc-title')!.textContent = data ? 'Editar contenido' : 'Nuevo contenido';
    (document.getElementById('fc-id') as HTMLInputElement).value = data?.id||'';
    (document.getElementById('fc-date') as HTMLInputElement).value = data?.date || S.selDate || '';
    (document.getElementById('fc-time') as HTMLInputElement).value = data?.publish_time?.slice(0,5)||'';
    (document.getElementById('fc-platform') as HTMLSelectElement).value = data?.platform||'instagram_reel';
    (document.getElementById('fc-title') as HTMLInputElement).value = data?.title||'';
    (document.getElementById('fc-script') as HTMLTextAreaElement).value = data?.script||'';
    (document.getElementById('fc-caption') as HTMLTextAreaElement).value = data?.caption||'';
    (document.getElementById('fc-status') as HTMLSelectElement).value = data?.status||'pendiente';
    (document.getElementById('fc-notes') as HTMLTextAreaElement).value = data?.notes||'';
  }
  if (type==='task') {
    document.getElementById('mt-title')!.textContent = data ? 'Editar tarea' : 'Nueva tarea';
    (document.getElementById('ft-id') as HTMLInputElement).value = data?.id||'';
    (document.getElementById('ft-title') as HTMLInputElement).value = data?.title||'';
    (document.getElementById('ft-desc') as HTMLTextAreaElement).value = data?.description||'';
    (document.getElementById('ft-pri') as HTMLSelectElement).value = data?.priority||'normal';
    (document.getElementById('ft-status') as HTMLSelectElement).value = data?.status||'pendiente';
    (document.getElementById('ft-due') as HTMLInputElement).value = data?.due_date||'';
  }
  if (type==='improvement') {
    document.getElementById('mi-title')!.textContent = data ? 'Editar mejora' : 'Nueva mejora';
    (document.getElementById('fi-id') as HTMLInputElement).value = data?.id||'';
    (document.getElementById('fi-title') as HTMLInputElement).value = data?.title||'';
    (document.getElementById('fi-desc') as HTMLTextAreaElement).value = data?.description||'';
    (document.getElementById('fi-cat') as HTMLSelectElement).value = data?.category||'contenido';
    (document.getElementById('fi-status') as HTMLSelectElement).value = data?.status||'pendiente';
  }
  document.getElementById(`modal-${type}`)!.classList.add('open');
};

(window as any).closeModal = function(type: string) {
  document.getElementById(`modal-${type}`)!.classList.remove('open');
};

document.getElementById('form-content')?.addEventListener('submit', async e => {
  e.preventDefault();
  const btn = document.getElementById('fc-save') as HTMLButtonElement;
  const errEl = document.getElementById('fc-err')!;
  btn.textContent = 'Guardando...'; btn.disabled = true;
  errEl.style.display = 'none';

  const id = (document.getElementById('fc-id') as HTMLInputElement).value;
  const payload = {
    date:         (document.getElementById('fc-date') as HTMLInputElement).value,
    publish_time: (document.getElementById('fc-time') as HTMLInputElement).value || null,
    platform:     (document.getElementById('fc-platform') as HTMLSelectElement).value,
    title:        (document.getElementById('fc-title') as HTMLInputElement).value,
    script:       (document.getElementById('fc-script') as HTMLTextAreaElement).value || null,
    caption:      (document.getElementById('fc-caption') as HTMLTextAreaElement).value || null,
    status:       (document.getElementById('fc-status') as HTMLSelectElement).value,
    notes:        (document.getElementById('fc-notes') as HTMLTextAreaElement).value || null,
  };

  const { error } = id
    ? await supabase.from('bazit_content').update(payload).eq('id', id)
    : await supabase.from('bazit_content').insert(payload);

  if (error) {
    errEl.textContent = `Error al guardar: ${error.message}`;
    errEl.style.display = '';
    btn.textContent = 'Guardar'; btn.disabled = false;
    return;
  }

  // Actualizar fecha seleccionada al día guardado
  S.selDate = payload.date;
  (window as any).closeModal('content');

  // Re-fetch data para el mes actual y re-renderizar
  const start = `${S.year}-${pad(S.month+1)}-01`;
  const lastDay2 = new Date(S.year, S.month+1, 0).getDate();
  const end = `${S.year}-${pad(S.month+1)}-${pad(lastDay2)}`;
  const { data: fresh } = await supabase
    .from('bazit_content')
    .select('id,date,platform,title,publish_time,status')
    .gte('date', start).lte('date', end)
    .order('publish_time', { ascending: true });
  S.monthData = fresh || [];
  renderCal();
  await renderDayPane(S.selDate);

  btn.textContent = 'Guardar'; btn.disabled = false;
});

// ── TASKS ──
async function loadTasks() {
  const list = document.getElementById('tasks-list')!;
  list.innerHTML='<div class="empty-state"><div class="empty-msg">Cargando...</div></div>';
  let q = supabase.from('bazit_tasks').select('*').order('created_at',{ascending:false});
  if (S.taskFilter!=='all') q = q.eq('status',S.taskFilter);
  const { data } = await q; S.tasks = data||[];
  const { count } = await supabase.from('bazit_tasks').select('*',{count:'exact',head:true}).in('status',['pendiente','en_progreso']);
  const b = document.getElementById('tasks-badge')!;
  b.textContent = String(count||0); b.style.display = count ? '' : 'none';

  if (!S.tasks.length) { list.innerHTML='<div class="empty-state"><div class="empty-msg">Sin tareas aquí</div></div>'; return; }
  const priCls: Record<string,string> = {alta:'pri-h',normal:'pri-n',baja:'pri-l'};
  const priLbl: Record<string,string> = {alta:'↑ Alta',normal:'→ Normal',baja:'↓ Baja'};

  list.innerHTML = S.tasks.map(t => {
    const s = TC[t.status]||TC.pendiente;
    const done = t.status==='completado';
    const due = t.due_date ? `<span style="font-size:11px;color:rgba(255,255,255,0.28);">📅 ${fmtDate(t.due_date)}</span>` : '';
    return `<div class="task-card">
      <button class="tc-check${done?' done':''}" onclick="toggleTask('${t.id}','${t.status}')">
        ${done?'<svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="white"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>':''}
      </button>
      <div style="flex:1;min-width:0;">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;">
          <p class="tc-title${done?' done':''}">${esc(t.title)}</p>
          <span class="badge ${s.cls}">${s.label}</span>
        </div>
        ${t.description ? `<p class="tc-desc">${esc(t.description)}</p>` : ''}
        <div class="tc-meta">
          <span class="${priCls[t.priority]||'pri-n'}">${priLbl[t.priority]||'Normal'}</span>
          ${due}
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:2px;">
        <button onclick="openModal('task',${JSON.stringify(t).replace(/"/g,'&quot;')})" style="color:rgba(255,255,255,0.25);background:none;border:none;cursor:pointer;padding:4px;min-height:auto;border-radius:6px;transition:all 0.15s;" onmouseover="this.style.color='rgba(255,255,255,0.6)'" onmouseout="this.style.color='rgba(255,255,255,0.25)'">
          <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/></svg>
        </button>
        <button onclick="delTask('${t.id}')" style="color:rgba(248,113,113,0.3);background:none;border:none;cursor:pointer;padding:4px;min-height:auto;border-radius:6px;transition:all 0.15s;" onmouseover="this.style.color='#f87171'" onmouseout="this.style.color='rgba(248,113,113,0.3)'">
          <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>`;
  }).join('');
}

