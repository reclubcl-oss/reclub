---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Crea con IA — ReClub"
  description="Crea contenido, diseño y estrategia digital impulsado por inteligencia artificial. Powered by Claude."
>
  <!-- ────────────────────────────────────────── NAV ── -->
  <nav class="fixed top-0 inset-x-0 z-50 flex items-center justify-between px-6 py-4 bg-brand-black/80 backdrop-blur-xl border-b border-brand-border/40">
    <a href="/" class="flex items-center gap-2 min-h-0">
      <span class="text-lg font-bold tracking-tight text-brand-white">Re<span class="text-brand-blue">Club</span></span>
    </a>
    <div class="flex items-center gap-3">
      <span class="hidden sm:flex items-center gap-1.5 text-xs text-brand-muted border border-brand-border/60 px-3 py-1.5 rounded-full">
        <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse"></span>
        Powered by Claude
      </span>
      <a href="#empezar" class="bg-brand-blue hover:bg-brand-blue-dark text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors duration-200 min-h-0 h-9">
        Empezar
      </a>
    </div>
  </nav>

  <!-- ────────────────────────────────────────── HERO ── -->
  <section class="relative flex flex-col items-center justify-center overflow-hidden bg-brand-black" style="min-height: 100svh; padding-top: 80px;">

    <!-- Grid pattern -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(59,130,246,0.06)_1px,transparent_1px),linear-gradient(90deg,rgba(59,130,246,0.06)_1px,transparent_1px)] bg-[size:48px_48px]"></div>

    <!-- Deep blue radial glow -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_60%_at_50%_0%,rgba(37,99,235,0.25),transparent)]"></div>
    <div class="absolute bottom-0 inset-x-0 h-64 bg-[radial-gradient(ellipse_80%_100%_at_50%_100%,rgba(59,130,246,0.08),transparent)]"></div>

    <!-- Blobs animados -->
    <div class="absolute top-1/4 left-1/6 w-80 h-80 bg-brand-blue/12 rounded-full blur-3xl animate-blob"></div>
    <div class="absolute top-1/3 right-1/6 w-72 h-72 bg-brand-purple/10 rounded-full blur-3xl animate-blob animation-delay-2000"></div>
    <div class="absolute bottom-1/4 left-1/2 w-56 h-56 bg-brand-blue/8 rounded-full blur-3xl animate-blob animation-delay-4000"></div>

    <!-- Líneas decorativas -->
    <div class="absolute top-1/2 left-0 w-full h-px bg-gradient-to-r from-transparent via-brand-blue/20 to-transparent"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 text-center">

      <!-- Badge Claude -->
      <div class="inline-flex items-center gap-2.5 border border-brand-blue/30 bg-brand-blue/8 text-brand-blue text-xs font-medium px-4 py-2 rounded-full mb-8" data-aos="fade-down">
        <!-- Claude icon -->
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M8 1L14 4.5V11.5L8 15L2 11.5V4.5L8 1Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <circle cx="8" cy="8" r="2" fill="currentColor"/>
        </svg>
        Diseño potenciado por Claude AI
      </div>

      <!-- Headline principal -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold leading-[0.95] tracking-tight mb-6" data-aos="fade-up" data-aos-delay="100">
        <span class="text-brand-white">Crea con</span>
        <br />
        <span class="bg-gradient-to-r from-blue-400 via-brand-blue to-brand-purple bg-clip-text text-transparent">
          IA aquí
        </span>
      </h1>

      <!-- Subtítulo -->
      <p class="text-brand-muted text-lg md:text-xl max-w-2xl mx-auto mb-10 leading-relaxed" data-aos="fade-up" data-aos-delay="200">
        Diseño, contenido y estrategia digital generados por inteligencia artificial.
        <br class="hidden sm:block" />
        El futuro de tu marca comienza ahora.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-3 justify-center max-w-sm sm:max-w-none mx-auto mb-16" data-aos="fade-up" data-aos-delay="300">
        <a id="empezar" href="#capacidades" class="group relative bg-brand-blue hover:bg-brand-blue-dark text-white px-8 py-4 rounded-xl font-semibold transition-all duration-200 shadow-[0_0_30px_rgba(59,130,246,0.4)] hover:shadow-[0_0_50px_rgba(59,130,246,0.6)] w-full sm:w-auto text-center overflow-hidden">
          <span class="relative z-10 flex items-center justify-center gap-2">
            Comenzar a crear
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 group-hover:translate-x-0.5 transition-transform">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
            </svg>
          </span>
        </a>
        <a href="/" class="border border-brand-border text-brand-white px-8 py-4 rounded-xl font-semibold hover:border-brand-blue/50 hover:bg-brand-blue/5 transition-all duration-200 w-full sm:w-auto text-center">
          Volver al inicio
        </a>
      </div>

      <!-- Claude design token preview -->
      <div class="flex items-center justify-center gap-6 text-xs text-brand-muted" data-aos="fade-up" data-aos-delay="400">
        <div class="flex items-center gap-1.5">
          <div class="w-3 h-3 rounded-sm bg-brand-blue"></div>
          <span>Claude Blue</span>
        </div>
        <div class="w-px h-4 bg-brand-border"></div>
        <div class="flex items-center gap-1.5">
          <div class="w-3 h-3 rounded-sm bg-brand-purple"></div>
          <span>ReClub Purple</span>
        </div>
        <div class="w-px h-4 bg-brand-border"></div>
        <div class="flex items-center gap-1.5">
          <div class="w-3 h-3 rounded-sm bg-brand-card border border-brand-border"></div>
          <span>Surface Dark</span>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-brand-muted">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </div>
  </section>

  <!-- ────────────────────────────────────────── SISTEMA DE DISEÑO CLAUDE ── -->
  <section class="py-20 px-4 bg-brand-dark border-y border-brand-border/40">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row items-center gap-8 md:gap-16">
        <!-- Logo Claude -->
        <div class="flex-shrink-0 flex flex-col items-center gap-4" data-aos="fade-right">
          <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-brand-blue to-brand-purple flex items-center justify-center shadow-[0_0_40px_rgba(59,130,246,0.3)]">
            <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M18 3L33 11.25V24.75L18 33L3 24.75V11.25L18 3Z" stroke="white" stroke-width="2" stroke-linejoin="round"/>
              <path d="M18 10L26 14.5V23.5L18 28L10 23.5V14.5L18 10Z" fill="white" fill-opacity="0.2"/>
              <circle cx="18" cy="18" r="4" fill="white"/>
            </svg>
          </div>
          <span class="text-xs text-brand-muted font-mono uppercase tracking-widest">Claude Design</span>
        </div>

        <!-- Descripción -->
        <div class="flex-1 text-center md:text-left" data-aos="fade-left">
          <h2 class="text-2xl md:text-3xl font-bold text-brand-white mb-3">
            Sistema de diseño potenciado por <span class="text-brand-blue">Claude</span>
          </h2>
          <p class="text-brand-muted leading-relaxed mb-6 max-w-xl">
            Esta página usa los tokens de diseño de Claude como base — tipografía limpia, espaciado consistente, jerarquía visual clara — fusionados con la identidad futurista de ReClub.
          </p>
          <!-- Design tokens -->
          <div class="flex flex-wrap gap-2 justify-center md:justify-start">
            {['Inter Typeface', 'Blue #3B82F6', 'Surface Dark', '8px Grid', 'Fluid Motion', 'A11y First'].map(token => (
              <span class="text-xs text-brand-blue bg-brand-blue/10 border border-brand-blue/20 px-3 py-1.5 rounded-full font-mono">
                {token}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ────────────────────────────────────────── CAPACIDADES ── -->
  <section id="capacidades" class="py-24 px-4 bg-brand-black">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-16" data-aos="fade-up">
        <p class="text-brand-blue text-xs font-semibold tracking-[0.2em] uppercase mb-3">Qué puedes crear</p>
        <h2 class="text-3xl md:text-5xl font-extrabold text-brand-white mb-4 tracking-tight">
          IA para todo tu negocio
        </h2>
        <div class="w-12 h-0.5 bg-gradient-to-r from-brand-blue to-brand-purple rounded mx-auto"></div>
      </div>

      <!-- Grid de capacidades -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">

        <!-- Card 1: Contenido -->
        <div class="group relative bg-brand-card border border-brand-border rounded-2xl p-7 hover:border-brand-blue/40 hover:-translate-y-1 transition-all duration-300 overflow-hidden" data-aos="fade-up" data-aos-delay="0">
          <div class="absolute inset-0 bg-gradient-to-br from-brand-blue/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="relative z-10">
            <div class="w-11 h-11 rounded-xl bg-brand-blue/15 flex items-center justify-center mb-5">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#3B82F6" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
              </svg>
            </div>
            <h3 class="text-brand-white font-bold text-lg mb-2">Contenido & Copy</h3>
            <p class="text-brand-muted text-sm leading-relaxed">Posts para redes, descripciones de productos, newsletters y campañas escritas por IA en segundos.</p>
            <div class="mt-5 flex items-center gap-1.5 text-brand-blue text-xs font-medium">
              <span class="w-1 h-1 bg-brand-blue rounded-full"></span>
              Texto · Hashtags · Emails
            </div>
          </div>
        </div>

        <!-- Card 2: Diseño -->
        <div class="group relative bg-brand-card border border-brand-border rounded-2xl p-7 hover:border-brand-blue/40 hover:-translate-y-1 transition-all duration-300 overflow-hidden" data-aos="fade-up" data-aos-delay="80">
          <div class="absolute inset-0 bg-gradient-to-br from-brand-purple/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="relative z-10">
            <div class="w-11 h-11 rounded-xl bg-brand-purple/15 flex items-center justify-center mb-5">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#8B5CF6" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42" />
              </svg>
            </div>
            <h3 class="text-brand-white font-bold text-lg mb-2">Identidad Visual</h3>
            <p class="text-brand-muted text-sm leading-relaxed">Genera paletas de color, propuestas de marca y layouts para tu negocio con guía de IA.</p>
            <div class="mt-5 flex items-center gap-1.5 text-brand-purple text-xs font-medium">
              <span class="w-1 h-1 bg-brand-purple rounded-full"></span>
              Colores · Tipografías · Logos
            </div>
          </div>
        </div>

        <!-- Card 3: Web -->
        <div class="group relative bg-brand-card border border-brand-border rounded-2xl p-7 hover:border-brand-blue/40 hover:-translate-y-1 transition-all duration-300 overflow-hidden" data-aos="fade-up" data-aos-delay="160">
          <div class="absolute inset-0 bg-gradient-to-br from-brand-blue/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="relative z-10">
            <div class="w-11 h-11 rounded-xl bg-brand-blue/15 flex items-center justify-center mb-5">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#3B82F6" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
              </svg>
            </div>
            <h3 class="text-brand-white font-bold text-lg mb-2">Código & Web</h3>
            <p class="text-brand-muted text-sm leading-relaxed">Componentes, páginas y funcionalidades web generadas automáticamente por IA para tu proyecto.</p>
            <div class="mt-5 flex items-center gap-1.5 text-brand-blue text-xs font-medium">
              <span class="w-1 h-1 bg-brand-blue rounded-full"></span>
              HTML · CSS · JavaScript
            </div>
          </div>
        </div>

        <!-- Card 4: Estrategia -->
        <div class="group relative bg-brand-card border border-brand-border rounded-2xl p-7 hover:border-brand-blue/40 hover:-translate-y-1 transition-all duration-300 overflow-hidden" data-aos="fade-up" data-aos-delay="0">
          <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="relative z-10">
            <div class="w-11 h-11 rounded-xl bg-emerald-500/15 flex items-center justify-center mb-5">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#10B981" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6" />
              </svg>
            </div>
            <h3 class="text-brand-white font-bold text-lg mb-2">Estrategia Digital</h3>
            <p class="text-brand-muted text-sm leading-relaxed">Plan de marketing, calendario editorial y análisis de competencia generados con inteligencia artificial.</p>
            <div class="mt-5 flex items-center gap-1.5 text-emerald-400 text-xs font-medium">
              <span class="w-1 h-1 bg-emerald-400 rounded-full"></span>
              SEO · Redes · Campañas
            </div>
          </div>
        </div>

        <!-- Card 5: Fidelización -->
        <div class="group relative bg-brand-card border border-brand-border rounded-2xl p-7 hover:border-brand-blue/40 hover:-translate-y-1 transition-all duration-300 overflow-hidden" data-aos="fade-up" data-aos-delay="80">
          <div class="absolute inset-0 bg-gradient-to-br from-amber-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="relative z-10">
            <div class="w-11 h-11 rounded-xl bg-amber-500/15 flex items-center justify-center mb-5">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#F59E0B" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
              </svg>
            </div>
            <h3 class="text-brand-white font-bold text-lg mb-2">Fidelización IA</h3>
            <p class="text-brand-muted text-sm leading-relaxed">Mensajes personalizados, ofertas automáticas y recompensas inteligentes para tus clientes fieles.</p>
            <div class="mt-5 flex items-center gap-1.5 text-amber-400 text-xs font-medium">
              <span class="w-1 h-1 bg-amber-400 rounded-full"></span>
              Wallet · Puntos · Notificaciones
            </div>
          </div>
        </div>

        <!-- Card 6: Análisis -->
        <div class="group relative bg-gradient-to-br from-brand-blue/10 to-brand-purple/10 border border-brand-blue/30 rounded-2xl p-7 hover:border-brand-blue/60 hover:-translate-y-1 transition-all duration-300 overflow-hidden" data-aos="fade-up" data-aos-delay="160">
          <div class="absolute top-3 right-3">
            <span class="text-xs text-brand-blue bg-brand-blue/15 px-2 py-0.5 rounded-full font-medium">Próximamente</span>
          </div>
          <div class="relative z-10">
            <div class="w-11 h-11 rounded-xl bg-brand-blue/20 flex items-center justify-center mb-5">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#3B82F6" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />
              </svg>
            </div>
            <h3 class="text-brand-white font-bold text-lg mb-2">Análisis Predictivo</h3>
            <p class="text-brand-muted text-sm leading-relaxed">IA que predice tendencias, comportamiento de clientes y oportunidades de crecimiento para tu negocio.</p>
            <div class="mt-5 flex items-center gap-1.5 text-brand-blue text-xs font-medium">
              <span class="w-1 h-1 bg-brand-blue rounded-full animate-pulse"></span>
              En desarrollo con Claude
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ────────────────────────────────────────── CÓMO FUNCIONA ── -->
  <section class="py-24 px-4 bg-brand-dark relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_50%_50%,rgba(59,130,246,0.06),transparent)]"></div>

    <div class="relative z-10 max-w-4xl mx-auto">
      <div class="text-center mb-16" data-aos="fade-up">
        <p class="text-brand-blue text-xs font-semibold tracking-[0.2em] uppercase mb-3">Proceso</p>
        <h2 class="text-3xl md:text-4xl font-extrabold text-brand-white tracking-tight">
          Tan simple como hablar
        </h2>
      </div>

      <div class="space-y-4">
        {[
          { step: '01', title: 'Cuéntanos tu idea', desc: 'Escribe qué necesitas crear — contenido, diseño, estrategia o código. Sin tecnicismos.', color: 'text-brand-blue', border: 'border-brand-blue/30', bg: 'bg-brand-blue/10' },
          { step: '02', title: 'Claude la procesa', desc: 'Nuestra IA analiza tu solicitud y genera múltiples propuestas ajustadas a tu negocio y marca.', color: 'text-brand-purple', border: 'border-brand-purple/30', bg: 'bg-brand-purple/10' },
          { step: '03', title: 'Tú eliges y ajustas', desc: 'Selecciona la opción que más te guste y refínala con feedback en lenguaje natural.', color: 'text-emerald-400', border: 'border-emerald-500/30', bg: 'bg-emerald-500/10' },
          { step: '04', title: 'Publica y escala', desc: 'Exporta, publica o integra directamente en tu web y redes sociales desde ReClub.', color: 'text-amber-400', border: 'border-amber-500/30', bg: 'bg-amber-500/10' },
        ].map((item, i) => (
          <div class={`flex gap-5 items-start p-6 rounded-2xl bg-brand-card border ${item.border} hover:scale-[1.01] transition-transform duration-200`} data-aos="fade-up" data-aos-delay={i * 80}>
            <div class={`flex-shrink-0 w-10 h-10 rounded-xl ${item.bg} flex items-center justify-center`}>
              <span class={`text-xs font-mono font-bold ${item.color}`}>{item.step}</span>
            </div>
            <div>
              <h3 class={`font-bold text-brand-white mb-1 ${item.color}`}>{item.title}</h3>
              <p class="text-brand-muted text-sm leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ────────────────────────────────────────── CTA FINAL ── -->
  <section class="py-24 px-4 bg-brand-black relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_50%,rgba(37,99,235,0.12),transparent)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(rgba(59,130,246,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(59,130,246,0.04)_1px,transparent_1px)] bg-[size:48px_48px]"></div>

    <!-- Blob central -->
