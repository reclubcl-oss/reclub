---
import Layout from '../../layouts/Layout.astro';
import { checkAuth } from '../../lib/auth';

const authed = checkAuth(Astro.request);
---

<Layout title="Admin Leads WhatsApp — ReClub">
  <!-- LOGIN -->
  <div id="loginScreen" class={`min-h-screen flex items-center justify-center p-6 bg-brand-black ${authed ? 'hidden' : ''}`}>
    <div class="w-full max-w-sm">
      <div class="text-center mb-8">
        <div class="w-12 h-12 bg-[#16a34a]/10 border border-[#16a34a]/30 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 text-[#4ade80]">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
        </div>
        <h1 class="text-2xl font-black text-brand-white">Leads WhatsApp</h1>
        <p class="text-brand-muted text-sm mt-1">ReClub Admin</p>
      </div>
      <div class="bg-brand-card border border-brand-border rounded-2xl p-6">
        <div id="loginError" class="hidden mb-4 bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-xl"></div>
        <form id="loginForm" class="space-y-4">
          <div>
            <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Contraseña</label>
            <input type="password" id="loginPassword" required autocomplete="current-password"
              class="w-full bg-brand-dark border border-brand-border rounded-xl px-4 py-3 text-brand-white focus:border-[#16a34a] outline-none transition-colors placeholder:text-brand-muted/40"
              placeholder="••••••••"
            />
          </div>
          <button type="submit" id="loginBtn"
            class="w-full bg-[#16a34a] hover:bg-[#15803d] text-white py-3 rounded-xl font-semibold transition-colors disabled:opacity-50"
          >Entrar</button>
        </form>
      </div>
    </div>
  </div>

  <!-- DASHBOARD -->
  <div id="adminDashboard" class={`min-h-screen bg-brand-black ${authed ? '' : 'hidden'}`}>
    <!-- Header -->
    <header class="sticky top-0 z-40 border-b border-brand-border bg-brand-black/90 backdrop-blur-md px-4 sm:px-6 py-4 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 bg-[#16a34a]/10 border border-[#16a34a]/30 rounded-xl flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-[#4ade80]">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
        </div>
        <div>
          <p class="font-black text-brand-white text-sm leading-none">Leads WhatsApp</p>
          <p class="text-brand-muted text-xs">Sistema de Clientes</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <a href="/sistema-90" target="_blank" class="text-brand-muted hover:text-brand-white text-xs transition-colors hidden sm:flex items-center gap-1">
          Ver landing
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
        <button id="logoutBtn" class="text-brand-muted hover:text-red-400 text-xs transition-colors">Salir</button>
      </div>
    </header>

    <!-- Stats row -->
    <div class="px-4 sm:px-6 pt-6 pb-2">
      <div id="statsRow" class="grid grid-cols-2 sm:grid-cols-5 gap-3 mb-6"></div>
    </div>

    <!-- Filters -->
    <div class="px-4 sm:px-6 pb-4 flex flex-wrap gap-2 items-center">
      <button data-filter="" class="filter-btn active text-xs font-semibold px-3 py-1.5 rounded-full border border-brand-border bg-brand-card text-brand-white transition-colors">
        Todos
      </button>
      <button data-filter="nuevo" class="filter-btn text-xs font-semibold px-3 py-1.5 rounded-full border border-brand-border text-brand-muted hover:text-brand-white transition-colors">
        Nuevos
      </button>
      <button data-filter="contactado" class="filter-btn text-xs font-semibold px-3 py-1.5 rounded-full border border-brand-border text-brand-muted hover:text-brand-white transition-colors">
        Contactados
      </button>
      <button data-filter="negociando" class="filter-btn text-xs font-semibold px-3 py-1.5 rounded-full border border-brand-border text-brand-muted hover:text-brand-white transition-colors">
        En negociación
      </button>
      <button data-filter="cerrado" class="filter-btn text-xs font-semibold px-3 py-1.5 rounded-full border border-brand-border text-brand-muted hover:text-brand-white transition-colors">
        Cerrados
      </button>
      <button data-filter="descartado" class="filter-btn text-xs font-semibold px-3 py-1.5 rounded-full border border-brand-border text-brand-muted hover:text-brand-white transition-colors">
        Descartados
      </button>
    </div>

    <!-- Leads list -->
    <div id="leadsList" class="px-4 sm:px-6 pb-16 space-y-3"></div>
    <div id="emptyState" class="hidden text-center py-20 px-6">
      <p class="text-brand-muted text-sm">No hay leads en esta categoría.</p>
    </div>

    <!-- Detail modal -->
    <div id="modal" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-end sm:items-center justify-center p-4">
      <div class="bg-brand-card border border-brand-border rounded-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
        <div id="modalContent"></div>
      </div>
    </div>
  </div>
</Layout>

<script>
const STATUS_LABELS: Record<string, { label: string; color: string; bg: string }> = {
  nuevo:       { label: 'Nuevo',          color: '#4ade80', bg: '#16a34a20' },
  contactado:  { label: 'Contactado',     color: '#60a5fa', bg: '#2563eb20' },
  negociando:  { label: 'En negociación', color: '#fbbf24', bg: '#d9770020' },
  cerrado:     { label: 'Cerrado ✓',      color: '#a78bfa', bg: '#7c3aed20' },
  descartado:  { label: 'Descartado',     color: '#94a3b8', bg: '#1e293b' },
};

let currentFilter = '';
let allLeads: any[] = [];

// --- Auth ---
const loginForm = document.getElementById('loginForm') as HTMLFormElement;
const loginError = document.getElementById('loginError') as HTMLElement;
const loginScreen = document.getElementById('loginScreen') as HTMLElement;
const dashboard = document.getElementById('adminDashboard') as HTMLElement;

loginForm?.addEventListener('submit', async (e) => {
  e.preventDefault();
  loginError.classList.add('hidden');
  const password = (document.getElementById('loginPassword') as HTMLInputElement).value;
  const res = await fetch('/api/admin/login', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ password }),
  });
  if (res.ok) {
    loginScreen.classList.add('hidden');
    dashboard.classList.remove('hidden');
    loadLeads();
  } else {
    loginError.textContent = 'Contraseña incorrecta';
    loginError.classList.remove('hidden');
  }
});

document.getElementById('logoutBtn')?.addEventListener('click', async () => {
  await fetch('/api/admin/logout', { method: 'POST' });
  location.reload();
});

// --- Load ---
async function loadLeads() {
  const url = currentFilter
    ? `/api/leads/whatsapp?status=${currentFilter}`
    : '/api/leads/whatsapp';
  const res = await fetch(url);
  if (!res.ok) return;
  const data = await res.json();
  allLeads = data.leads;
  renderStats(data.leads);
  renderLeads(data.leads);
}

function renderStats(leads: any[]) {
  const counts: Record<string, number> = { nuevo: 0, contactado: 0, negociando: 0, cerrado: 0, descartado: 0 };
  leads.forEach((l: any) => { counts[l.status] = (counts[l.status] ?? 0) + 1; });
  const total = leads.length;

  const statsRow = document.getElementById('statsRow')!;
  statsRow.innerHTML = `
    <div class="bg-brand-card border border-brand-border rounded-xl p-4 col-span-2 sm:col-span-1">
      <p class="text-brand-muted text-xs mb-1">Total leads</p>
      <p class="text-2xl font-black text-brand-white">${total}</p>
    </div>
    ${Object.entries(counts).map(([s, c]) => {
      const cfg = STATUS_LABELS[s];
      return `
        <div class="bg-brand-card border border-brand-border rounded-xl p-4">
          <p class="text-xs mb-1" style="color:${cfg.color}">${cfg.label}</p>
          <p class="text-xl font-black text-brand-white">${c}</p>
        </div>
      `;
    }).join('')}
  `;
}

function renderLeads(leads: any[]) {
  const list = document.getElementById('leadsList')!;
  const empty = document.getElementById('emptyState')!;

  if (!leads.length) {
    list.innerHTML = '';
    empty.classList.remove('hidden');
    return;
  }
  empty.classList.add('hidden');

  list.innerHTML = leads.map((lead: any) => {
    const cfg = STATUS_LABELS[lead.status] ?? STATUS_LABELS.nuevo;
    const date = new Date(lead.created_at).toLocaleDateString('es-CL', { day: 'numeric', month: 'short', year: 'numeric' });
    const wa = `https://wa.me/${lead.whatsapp.replace(/\D/g, '')}`;
    return `
      <div class="bg-brand-card border border-brand-border rounded-2xl p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center gap-4 cursor-pointer hover:border-brand-blue/40 transition-colors" data-id="${lead.id}">
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-1 flex-wrap">
            <span class="font-bold text-brand-white text-sm">${lead.nombre}</span>
            <span class="text-xs px-2 py-0.5 rounded-full font-semibold" style="color:${cfg.color}; background:${cfg.bg}">
              ${cfg.label}
            </span>
          </div>
          <p class="text-brand-muted text-xs mb-1">${lead.negocio} · ${lead.rubro}</p>
          <p class="text-brand-muted text-xs">${lead.presupuesto}</p>
        </div>
        <div class="flex items-center gap-3 shrink-0">
          <a href="${wa}" target="_blank" rel="noopener noreferrer"
            onclick="event.stopPropagation()"
            class="inline-flex items-center gap-1.5 bg-[#16a34a]/10 border border-[#16a34a]/30 text-[#4ade80] text-xs font-semibold px-3 py-1.5 rounded-full hover:bg-[#16a34a]/20 transition-colors">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
          <span class="text-brand-muted text-xs hidden sm:block">${date}</span>
        </div>
      </div>
    `;
  }).join('');

  // Click to open modal
  list.querySelectorAll('[data-id]').forEach(el => {
    el.addEventListener('click', () => {
      const id = parseInt((el as HTMLElement).dataset.id!);
      openModal(allLeads.find((l: any) => l.id === id));
    });
  });
}

// --- Filters ---
document.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => {
      b.classList.remove('active', 'bg-brand-card', 'text-brand-white');
      b.classList.add('text-brand-muted');
    });
    btn.classList.add('active', 'bg-brand-card', 'text-brand-white');
    btn.classList.remove('text-brand-muted');
    currentFilter = (btn as HTMLElement).dataset.filter ?? '';
    loadLeads();
  });
});

// --- Modal ---
function openModal(lead: any) {
  const cfg = STATUS_LABELS[lead.status] ?? STATUS_LABELS.nuevo;
  const date = new Date(lead.created_at).toLocaleString('es-CL', { timeZone: 'America/Santiago', day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  const wa = `https://wa.me/${lead.whatsapp.replace(/\D/g, '')}`;

  const modal = document.getElementById('modal')!;
  const content = document.getElementById('modalContent')!;

  content.innerHTML = `
    <div class="p-5 sm:p-6">
      <div class="flex items-start justify-between gap-3 mb-5">
        <div>
          <h2 class="font-black text-brand-white text-lg leading-tight">${lead.nombre}</h2>
          <p class="text-brand-muted text-sm">${lead.negocio} · ${lead.rubro}</p>
        </div>
        <button id="closeModal" class="text-brand-muted hover:text-brand-white transition-colors shrink-0 mt-1">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="grid grid-cols-2 gap-3 mb-5">
        <div class="bg-brand-dark border border-brand-border rounded-xl p-3">
          <p class="text-brand-muted text-xs mb-1">WhatsApp</p>
          <a href="${wa}" target="_blank" class="text-[#4ade80] font-semibold text-sm hover:underline">${lead.whatsapp}</a>
        </div>
        <div class="bg-brand-dark border border-brand-border rounded-xl p-3">
          <p class="text-brand-muted text-xs mb-1">Email</p>
          <a href="mailto:${lead.email}" class="text-brand-blue font-semibold text-sm hover:underline break-all">${lead.email}</a>
        </div>
        <div class="bg-brand-dark border border-brand-border rounded-xl p-3">
          <p class="text-brand-muted text-xs mb-1">Presupuesto</p>
          <p class="text-brand-white font-semibold text-sm">${lead.presupuesto}</p>
        </div>
        <div class="bg-brand-dark border border-brand-border rounded-xl p-3">
          <p class="text-brand-muted text-xs mb-1">Fecha</p>
          <p class="text-brand-white text-sm">${date}</p>
        </div>
      </div>

      ${lead.mensaje ? `
        <div class="bg-brand-dark border border-brand-border rounded-xl p-4 mb-5">
          <p class="text-brand-muted text-xs mb-2">Mensaje</p>
          <p class="text-brand-white text-sm leading-relaxed">${lead.mensaje}</p>
        </div>
      ` : ''}

      <div class="mb-4">
        <p class="text-brand-muted text-xs mb-2 font-medium uppercase tracking-wider">Estado</p>
        <div class="flex flex-wrap gap-2" id="statusBtns">
          ${Object.entries(STATUS_LABELS).map(([s, c]) => `
            <button data-status="${s}"
              class="status-btn text-xs font-semibold px-3 py-1.5 rounded-full border transition-colors ${lead.status === s ? 'border-transparent text-white' : 'border-brand-border text-brand-muted hover:text-brand-white'}"
              style="${lead.status === s ? `background:${c.bg}; color:${c.color}; border-color:${c.color}40` : ''}"
            >
              ${c.label}
            </button>
          `).join('')}
        </div>
      </div>

      <div class="mb-5">
        <p class="text-brand-muted text-xs mb-2 font-medium uppercase tracking-wider">Notas internas</p>
        <textarea id="notasInput" rows="3" placeholder="Ej: Llamé el martes, interesado en plan de 3 meses..."
          class="w-full bg-brand-dark border border-brand-border rounded-xl px-4 py-3 text-brand-white text-sm resize-none focus:border-brand-blue outline-none transition-colors placeholder:text-brand-muted/40"
        >${lead.notas ?? ''}</textarea>
      </div>

      <div class="flex gap-3">
        <a href="${wa}" target="_blank" rel="noopener noreferrer"
          class="flex-1 flex items-center justify-center gap-2 bg-[#16a34a] hover:bg-[#15803d] text-white font-bold py-3 rounded-xl transition-colors text-sm">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Abrir WhatsApp
        </a>
        <button id="saveBtn"
          class="flex-1 bg-brand-blue hover:bg-brand-blue-dark text-white font-bold py-3 rounded-xl transition-colors text-sm"
          data-id="${lead.id}"
        >
          Guardar cambios
        </button>
      </div>
    </div>
  `;

  modal.classList.remove('hidden');

  // Close
  document.getElementById('closeModal')!.addEventListener('click', () => modal.classList.add('hidden'));
  modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.add('hidden'); });

  // Status buttons
  let selectedStatus = lead.status;
  document.querySelectorAll('.status-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      selectedStatus = (btn as HTMLElement).dataset.status!;
      const cfg = STATUS_LABELS[selectedStatus];
      document.querySelectorAll('.status-btn').forEach(b => {
        (b as HTMLElement).style.background = '';
        (b as HTMLElement).style.color = '';
        (b as HTMLElement).style.borderColor = '';
        b.classList.remove('text-white');
        b.classList.add('text-brand-muted');
      });
      (btn as HTMLElement).style.background = cfg.bg;
      (btn as HTMLElement).style.color = cfg.color;
      (btn as HTMLElement).style.borderColor = cfg.color + '40';
      btn.classList.add('text-white');
      btn.classList.remove('text-brand-muted');
    });
  });

  // Save
  document.getElementById('saveBtn')!.addEventListener('click', async (e) => {
    const id = parseInt((e.currentTarget as HTMLElement).dataset.id!);
    const notas = (document.getElementById('notasInput') as HTMLTextAreaElement).value;
    const saveBtn = e.currentTarget as HTMLButtonElement;
    saveBtn.textContent = 'Guardando...';
    saveBtn.disabled = true;

    await fetch('/api/leads/whatsapp', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id, status: selectedStatus, notas }),
    });

    modal.classList.add('hidden');
    loadLeads();
  });
}

// Init
if (document.getElementById('adminDashboard')!.classList.contains('hidden') === false) {
  loadLeads();
}
</script>
