---
import Layout from '../../layouts/Layout.astro';
import { checkAuth } from '../../lib/auth';

const authed = checkAuth(Astro.request);
---

<Layout title="Admin — ReClub">
  <!-- LOGIN -->
  <div id="loginScreen" class={`min-h-screen flex items-center justify-center p-6 bg-brand-black ${authed ? 'hidden' : ''}`}>
    <div class="w-full max-w-sm">
      <div class="text-center mb-8">
        <div class="w-12 h-12 bg-brand-blue/10 border border-brand-blue/30 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
        </div>
        <h1 class="text-2xl font-black text-brand-white">Panel Admin</h1>
        <p class="text-brand-muted text-sm mt-1">ReClub Agencia Digital</p>
      </div>
      <div class="bg-brand-card border border-brand-border rounded-2xl p-6">
        <div id="loginError" class="hidden mb-4 bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-xl"></div>
        <form id="loginForm" class="space-y-4">
          <div>
            <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Contraseña</label>
            <input type="password" id="loginPassword" required autocomplete="current-password"
              class="w-full bg-brand-dark border border-brand-border rounded-xl px-4 py-3 text-brand-white focus:border-brand-blue outline-none transition-colors placeholder:text-brand-muted/40"
              placeholder="••••••••"
            />
          </div>
          <button type="submit" id="loginBtn"
            class="w-full bg-brand-blue hover:bg-brand-blue-dark text-white py-3 rounded-xl font-semibold transition-colors disabled:opacity-50"
          >Entrar</button>
        </form>
      </div>
      <p class="text-center mt-6">
        <a href="/portafolio" class="text-brand-muted text-sm hover:text-brand-white transition-colors">← Ver portafolio</a>
      </p>
    </div>
  </div>

  <!-- DASHBOARD -->
  <div id="adminDashboard" class={`min-h-screen bg-brand-black ${authed ? '' : 'hidden'}`}>
    <header class="sticky top-0 z-40 border-b border-brand-border bg-brand-black/90 backdrop-blur-md px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 bg-brand-blue/10 border border-brand-blue/30 rounded-xl flex items-center justify-center">
          <svg class="w-4 h-4 text-brand-blue" fill="currentColor" viewBox="0 0 24 24">
            <path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8 12.5v-9l6 4.5-6 4.5z"/>
          </svg>
        </div>
        <div>
          <p class="font-black text-brand-white text-sm leading-none">Admin</p>
          <p class="text-brand-muted text-xs">ReClub</p>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <a href="/portafolio" target="_blank" class="text-brand-muted hover:text-brand-white text-sm transition-colors hidden sm:flex items-center gap-1">
          Ver portafolio
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
        <button id="logoutBtn" class="text-brand-muted hover:text-red-400 text-sm transition-colors flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
          </svg>
          Salir
        </button>
      </div>
    </header>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
      <!-- Tabs -->
      <div class="flex gap-2 mb-8 border-b border-brand-border pb-4 flex-wrap">
        <button class="tab-btn active" data-tab="videos">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/></svg>
          Videos
        </button>
        <button class="tab-btn" data-tab="photos">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          Fotos
        </button>
        <button class="tab-btn" data-tab="brands">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          Marcas
        </button>
        <button class="tab-btn" data-tab="perfil">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          Mi Perfil
        </button>
        <button class="tab-btn" data-tab="apariencia">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/></svg>
          Apariencia
        </button>
      </div>

      <!-- ===== VIDEOS TAB ===== -->
      <div id="tab-videos" class="tab-content">
        <div class="bg-brand-card border border-brand-border rounded-2xl p-6 mb-8">
          <div class="flex items-center gap-3 mb-1">
            <svg class="w-5 h-5 text-[#E1306C]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            <h2 class="font-bold text-brand-white">Agregar video de Instagram</h2>
          </div>
          <p class="text-brand-muted text-xs mb-6 ml-8">Pega el link del Reel o post de Instagram</p>
          <form id="videoForm" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Título *</label>
                <input type="text" name="title" required class="w-full bg-brand-dark border border-brand-border rounded-xl px-4 py-3 text-brand-white focus:border-brand-blue outline-none transition-colors text-sm" placeholder="Nombre del proyecto"/>
              </div>
              <div>
                <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Categoría</label>
                <input type="text" name="category" class="w-full bg-brand-dark border border-brand-border rounded-xl px-4 py-3 text-brand-white focus:border-brand-blue outline-none transition-colors text-sm" placeholder="Redes Sociales, Publicidad..."/>
              </div>
            </div>
            <div>
              <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Link de Instagram *</label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-brand-muted/50">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                </span>
                <input type="url" name="instagram_url" required id="instagramUrlInput"
                  class="w-full bg-brand-dark border border-brand-border rounded-xl pl-10 pr-4 py-3 text-brand-white focus:border-brand-blue outline-none transition-colors text-sm"
                  placeholder="https://www.instagram.com/reel/ABC123..."/>
              </div>
              <p id="urlValidation" class="text-xs mt-1.5 hidden"></p>
            </div>
            <div id="videoSuccess" class="hidden bg-green-500/10 border border-green-500/30 text-green-400 text-sm px-4 py-3 rounded-xl">✓ Video agregado con éxito</div>
            <div id="videoError" class="hidden bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-xl"></div>
            <button type="submit" id="videoSubmitBtn" class="bg-brand-blue hover:bg-brand-blue-dark text-white px-8 py-3 rounded-xl font-semibold transition-colors text-sm disabled:opacity-50">Agregar video</button>
          </form>
        </div>
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-bold text-brand-white">Videos publicados</h2>
          <button id="refreshVideos" class="text-brand-muted hover:text-brand-white text-xs transition-colors">↻ Actualizar</button>
        </div>
        <div id="videosList" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <div class="col-span-full text-brand-muted text-sm py-8 text-center">Cargando...</div>
        </div>
      </div>

      <!-- ===== PHOTOS TAB ===== -->
      <div id="tab-photos" class="tab-content hidden">
        <div class="bg-brand-card border border-brand-border rounded-2xl p-6 mb-8">
          <h2 class="font-bold text-brand-white mb-1">Subir nueva foto</h2>
          <p class="text-brand-muted text-xs mb-6">Formatos: JPG, PNG, WebP</p>
          <form id="photoForm" class="space-y-4">
            <div>
              <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Título *</label>
              <input type="text" name="title" required class="w-full bg-brand-dark border border-brand-border rounded-xl px-4 py-3 text-brand-white focus:border-brand-blue outline-none transition-colors text-sm" placeholder="Nombre del proyecto"/>
            </div>
            <div>
              <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Archivo *</label>
              <label class="block w-full bg-brand-dark border border-dashed border-brand-border hover:border-brand-blue/50 rounded-xl px-4 py-4 cursor-pointer transition-colors group">
                <input type="file" name="photoFile" accept="image/*" required class="hidden" id="photoFileInput" multiple/>
                <div class="flex items-center gap-3">
                  <svg class="w-8 h-8 text-brand-muted/50 group-hover:text-brand-blue/70 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  <div>
                    <p id="photoFileName" class="text-brand-muted text-sm">Elegir imagen(es)</p>
                    <p class="text-brand-muted/40 text-xs">Puedes seleccionar varias a la vez</p>
                  </div>
                </div>
              </label>
            </div>
            <div id="photoProgress" class="hidden space-y-2">
              <div class="h-1.5 bg-brand-dark rounded-full overflow-hidden">
                <div id="photoProgressBar" class="h-full bg-gradient-to-r from-brand-blue to-brand-purple rounded-full transition-all duration-300 w-0"></div>
              </div>
              <p id="photoProgressText" class="text-brand-muted text-xs">Subiendo...</p>
            </div>
            <div id="photoSuccess" class="hidden bg-green-500/10 border border-green-500/30 text-green-400 text-sm px-4 py-3 rounded-xl">✓ Foto(s) subida(s) con éxito</div>
            <div id="photoError" class="hidden bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-xl"></div>
            <button type="submit" id="photoSubmitBtn" class="bg-brand-blue hover:bg-brand-blue-dark text-white px-8 py-3 rounded-xl font-semibold transition-colors text-sm disabled:opacity-50">Subir Foto(s)</button>
          </form>
        </div>
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-bold text-brand-white">Fotos publicadas</h2>
          <button id="refreshPhotos" class="text-brand-muted hover:text-brand-white text-xs transition-colors">↻ Actualizar</button>
        </div>
        <div id="photosList" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          <div class="col-span-full text-brand-muted text-sm py-8 text-center">Cargando...</div>
        </div>
      </div>

      <!-- ===== BRANDS TAB ===== -->
      <div id="tab-brands" class="tab-content hidden">
        <div class="bg-brand-card border border-brand-border rounded-2xl p-6 mb-8">
          <h2 class="font-bold text-brand-white mb-1">Agregar marca</h2>
          <p class="text-brand-muted text-xs mb-6">Aparece en la sección de marcas del portafolio</p>
          <form id="brandForm" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Nombre *</label>
                <input type="text" name="name" required class="w-full bg-brand-dark border border-brand-border rounded-xl px-4 py-3 text-brand-white focus:border-brand-blue outline-none transition-colors text-sm" placeholder="Nombre de la marca"/>
              </div>
              <div>
                <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Sitio web <span class="normal-case font-normal">(opcional)</span></label>
                <input type="url" name="websiteUrl" class="w-full bg-brand-dark border border-brand-border rounded-xl px-4 py-3 text-brand-white focus:border-brand-blue outline-none transition-colors text-sm" placeholder="https://..."/>
              </div>
            </div>
            <div>
              <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Logo <span class="normal-case font-normal">(PNG, SVG)</span></label>
              <label class="block w-full max-w-xs bg-brand-dark border border-dashed border-brand-border hover:border-brand-blue/50 rounded-xl px-4 py-4 cursor-pointer transition-colors group">
                <input type="file" name="logoFile" accept="image/*" class="hidden" id="logoFileInput"/>
                <div class="flex items-center gap-3">
                  <svg class="w-8 h-8 text-brand-muted/50 group-hover:text-brand-blue/70 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  <div>
                    <p id="logoFileName" class="text-brand-muted text-sm">Elegir logo</p>
                    <p class="text-brand-muted/40 text-xs">PNG, SVG, WebP</p>
                  </div>
                </div>
              </label>
            </div>
            <div id="brandError" class="hidden bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-xl"></div>
            <div id="brandSuccess" class="hidden bg-green-500/10 border border-green-500/30 text-green-400 text-sm px-4 py-3 rounded-xl">✓ Marca agregada</div>
            <button type="submit" id="brandSubmitBtn" class="bg-brand-blue hover:bg-brand-blue-dark text-white px-8 py-3 rounded-xl font-semibold transition-colors text-sm disabled:opacity-50">Agregar Marca</button>
          </form>
        </div>
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-bold text-brand-white">Marcas</h2>
          <button id="refreshBrands" class="text-brand-muted hover:text-brand-white text-xs transition-colors">↻ Actualizar</button>
        </div>
        <div id="brandsList" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          <div class="col-span-full text-brand-muted text-sm py-8 text-center">Cargando...</div>
        </div>
      </div>

      <!-- ===== PERFIL TAB ===== -->
      <div id="tab-perfil" class="tab-content hidden">
        <div class="bg-brand-card border border-brand-border rounded-2xl p-6 max-w-xl">
          <h2 class="font-bold text-brand-white mb-1">Foto de perfil</h2>
          <p class="text-brand-muted text-xs mb-6">Aparece en la sección principal del sitio</p>

          <!-- Preview -->
          <div class="flex items-center gap-6 mb-6">
            <div id="profilePhotoPreview" class="w-24 h-24 rounded-full bg-brand-dark border-2 border-brand-border overflow-hidden flex items-center justify-center shrink-0">
              <svg class="w-10 h-10 text-brand-muted/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
              </svg>
            </div>
            <div>
              <p class="text-brand-white text-sm font-medium mb-1">Tu foto de perfil</p>
              <p class="text-brand-muted text-xs">Se mostrará circular en la portada del sitio</p>
            </div>
          </div>

          <!-- Upload / Drop zone -->
          <div id="profileDropZone" class="relative w-full bg-brand-dark border-2 border-dashed border-brand-border hover:border-brand-blue/50 rounded-xl px-4 py-8 cursor-pointer transition-all duration-200 group mb-4 text-center">
            <input type="file" id="profilePhotoInput" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"/>
            <svg class="w-10 h-10 text-brand-muted/40 group-hover:text-brand-blue/60 transition-colors mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
            <p id="profilePhotoName" class="text-brand-muted text-sm font-medium">Arrastra tu foto aquí</p>
            <p class="text-brand-muted/40 text-xs mt-1">o haz clic para elegir · JPG, PNG, WebP</p>
          </div>

          <div id="profileProgress" class="hidden mb-4">
            <div class="h-2 bg-brand-dark rounded-full overflow-hidden">
              <div id="profileProgressBar" class="h-full bg-gradient-to-r from-brand-blue to-brand-purple transition-all duration-300" style="width:0%"></div>
            </div>
            <p id="profileProgressText" class="text-brand-muted text-xs mt-1">Subiendo...</p>
          </div>

          <div id="profileError" class="hidden mb-4 bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-xl"></div>
          <div id="profileSuccess" class="hidden mb-4 bg-green-500/10 border border-green-500/30 text-green-400 text-sm px-4 py-3 rounded-xl">✓ Foto actualizada — recarga el sitio para verla</div>

          <button id="uploadProfileBtn" disabled class="w-full bg-brand-blue hover:bg-brand-blue-dark disabled:opacity-40 text-white py-3 rounded-xl font-semibold transition-colors">
            Subir foto
          </button>
        </div>

        <!-- Bio / Name -->
        <div class="bg-brand-card border border-brand-border rounded-2xl p-6 max-w-xl mt-6">
          <h2 class="font-bold text-brand-white mb-4">Información personal</h2>
          <div class="space-y-4">
            <div>
              <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Nombre</label>
              <input type="text" id="profileName" class="w-full bg-brand-dark border border-brand-border rounded-xl px-4 py-3 text-brand-white focus:border-brand-blue outline-none transition-colors text-sm" placeholder="Tu nombre completo"/>
            </div>
            <div>
              <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Bio</label>
              <textarea id="profileBio" rows="3" class="w-full bg-brand-dark border border-brand-border rounded-xl px-4 py-3 text-brand-white focus:border-brand-blue outline-none transition-colors resize-none text-sm" placeholder="Cuéntale a tus visitantes quién eres..."></textarea>
            </div>
            <button id="saveProfileInfoBtn" class="bg-brand-blue hover:bg-brand-blue-dark text-white px-6 py-3 rounded-xl font-semibold transition-colors text-sm">
              Guardar cambios
            </button>
            <div id="profileInfoSuccess" class="hidden bg-green-500/10 border border-green-500/30 text-green-400 text-sm px-4 py-3 rounded-xl">✓ Guardado</div>
          </div>
        </div>
      </div>

      <!-- ===== APARIENCIA TAB ===== -->
      <div id="tab-apariencia" class="tab-content hidden">
        <div class="bg-brand-card border border-brand-border rounded-2xl p-6 mb-6">
          <h2 class="font-bold text-brand-white mb-1">Tema del sitio</h2>
          <p class="text-brand-muted text-xs mb-8">Cambia entre modo claro y oscuro. El cambio se aplica en todo el sitio público.</p>

          <div class="grid grid-cols-2 gap-4">
            <!-- Light -->
            <button id="themeLight" onclick="setTheme('light')"
              class="theme-option flex flex-col items-center gap-3 p-5 rounded-2xl border-2 transition-all duration-200 cursor-pointer"
            >
              <div class="w-full h-20 rounded-xl overflow-hidden">
                <div class="w-full h-full bg-[#EEF2FF] flex flex-col">
                  <div class="h-4 bg-white/80 flex items-center px-2"><div class="w-6 h-1.5 rounded bg-[#2563EB]/70"></div></div>
                  <div class="flex-1 p-2 grid grid-cols-3 gap-1">
                    <div class="bg-white rounded shadow-sm"></div>
                    <div class="bg-white rounded shadow-sm"></div>
                    <div class="bg-white rounded shadow-sm"></div>
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-brand-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/></svg>
                <span class="text-sm font-semibold text-brand-white">Claro</span>
              </div>
            </button>

            <!-- Dark -->
            <button id="themeDark" onclick="setTheme('dark')"
              class="theme-option flex flex-col items-center gap-3 p-5 rounded-2xl border-2 transition-all duration-200 cursor-pointer"
            >
              <div class="w-full h-20 rounded-xl overflow-hidden">
                <div class="w-full h-full bg-[#0A0A0A] flex flex-col">
                  <div class="h-4 bg-[#111]/80 flex items-center px-2"><div class="w-6 h-1.5 rounded bg-[#3B82F6]/70"></div></div>
                  <div class="flex-1 p-2 grid grid-cols-3 gap-1">
                    <div class="bg-[#1A1A1A] rounded"></div>
                    <div class="bg-[#1A1A1A] rounded"></div>
                    <div class="bg-[#1A1A1A] rounded"></div>
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-brand-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
                <span class="text-sm font-semibold text-brand-white">Oscuro</span>
              </div>
            </button>

            <!-- Midnight -->
            <button id="themeMidnight" onclick="setTheme('midnight')"
              class="theme-option flex flex-col items-center gap-3 p-5 rounded-2xl border-2 transition-all duration-200 cursor-pointer"
            >
              <div class="w-full h-20 rounded-xl overflow-hidden">
                <div class="w-full h-full bg-[#060B14] flex flex-col">
                  <div class="h-4 bg-[#0D1724]/80 flex items-center px-2"><div class="w-6 h-1.5 rounded bg-[#60A5FA]/70"></div></div>
                  <div class="flex-1 p-2 grid grid-cols-3 gap-1">
                    <div class="bg-[#121F33] rounded" style="border:1px solid #1E3352"></div>
                    <div class="bg-[#121F33] rounded" style="border:1px solid #1E3352"></div>
                    <div class="bg-[#121F33] rounded" style="border:1px solid #1E3352"></div>
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-brand-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                <span class="text-sm font-semibold text-brand-white">Midnight</span>
              </div>
            </button>

            <!-- Arena -->
            <button id="themeArena" onclick="setTheme('arena')"
              class="theme-option flex flex-col items-center gap-3 p-5 rounded-2xl border-2 transition-all duration-200 cursor-pointer"
            >
              <div class="w-full h-20 rounded-xl overflow-hidden">
                <div class="w-full h-full bg-[#FAF7F2] flex flex-col">
                  <div class="h-4 bg-white/80 flex items-center px-2"><div class="w-6 h-1.5 rounded bg-[#2563EB]/70"></div></div>
                  <div class="flex-1 p-2 grid grid-cols-3 gap-1">
                    <div class="bg-white rounded shadow-sm" style="border:1px solid #E0D5C8"></div>
                    <div class="bg-white rounded shadow-sm" style="border:1px solid #E0D5C8"></div>
                    <div class="bg-white rounded shadow-sm" style="border:1px solid #E0D5C8"></div>
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-brand-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"/></svg>
                <span class="text-sm font-semibold text-brand-white">Arena</span>
              </div>
            </button>
          </div>

          <div id="themeStatus" class="hidden mt-6 bg-green-500/10 border border-green-500/30 text-green-400 text-sm px-4 py-3 rounded-xl">✓ Tema actualizado — recarga el sitio público para ver el cambio</div>
          <div id="themeError" class="hidden mt-6 bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-xl"></div>
        </div>
      </div>

    </div>
  </div>
</Layout>

<style>
  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    transition: all 0.15s;
    color: #94A3B8;
    background: transparent;
    border: 1px solid transparent;
  }
  .tab-btn:hover { color: #F8FAFC; border-color: #1E293B; }
  .tab-btn.active { background: #3B82F6; color: white; border-color: transparent; }
</style>

<script>
  import { upload } from '@vercel/blob/client';

  const $ = (id: string) => document.getElementById(id)!;

  // ── Auth ──────────────────────────────────────────────────────────────────
  const isLoggedIn = !$('loginScreen').classList.contains('hidden') === false;

  $('loginForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = $('loginBtn') as HTMLButtonElement;
    const err = $('loginError');
    btn.disabled = true;
    btn.textContent = 'Entrando...';
    err.classList.add('hidden');

    const password = ($('loginPassword') as HTMLInputElement).value;
    const res = await fetch('/api/admin/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password }),
    });

    if (res.ok) {
      $('loginScreen').classList.add('hidden');
      $('adminDashboard').classList.remove('hidden');
      await Promise.all([loadVideos(), loadPhotos(), loadBrands()]);
    } else {
      const { error } = await res.json();
      err.textContent = error ?? 'Contraseña incorrecta';
      err.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Entrar';
    }
  });

  $('logoutBtn').addEventListener('click', async () => {
    await fetch('/api/admin/logout', { method: 'POST' });
    $('adminDashboard').classList.add('hidden');
    $('loginScreen').classList.remove('hidden');
  });

  // Load on mount if already authed
  if (!$('adminDashboard').classList.contains('hidden')) {
    Promise.all([loadVideos(), loadPhotos(), loadBrands()]);
  }

  // ── Tabs ──────────────────────────────────────────────────────────────────
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
      btn.classList.add('active');
      $(`tab-${(btn as HTMLElement).dataset.tab}`).classList.remove('hidden');
    });
  });

  // ── File name labels ──────────────────────────────────────────────────────
  function watchFile(inputId: string, labelId: string) {
    document.getElementById(inputId)?.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      $(labelId).textContent = files?.length === 1 ? files[0].name : files ? `${files.length} archivos` : 'Elegir archivo';
    });
  }
  watchFile('videoFileInput', 'videoFileName');
  watchFile('thumbFileInput', 'thumbFileName');
  watchFile('logoFileInput', 'logoFileName');
  watchFile('photoFileInput', 'photoFileName');

  // ── Upload to Vercel Blob ─────────────────────────────────────────────────
  async function uploadFile(file: File, onProgress?: (pct: number) => void): Promise<string> {
    const ext = file.name.split('.').pop() ?? 'bin';
    const filename = `${Date.now()}-${Math.random().toString(36).slice(2)}.${ext}`;
    const blob = await upload(filename, file, {
      access: 'public',
      handleUploadUrl: '/api/blob',
      onUploadProgress: ({ percentage }) => onProgress?.(percentage),
    });
    return blob.url;
  }

  // ── Videos ────────────────────────────────────────────────────────────────
  async function loadVideos() {
    const list = $('videosList');
    const res = await fetch('/api/admin/videos');
    const data: any[] = res.ok ? await res.json() : [];

    if (!data.length) {
      list.innerHTML = '<p class="col-span-full text-brand-muted text-sm py-8 text-center">No hay videos aún.</p>';
      return;
    }

    function igShortcode(url: string) {
      const m = url?.match(/(?:reel|p)\/([A-Za-z0-9_-]+)/);
      return m ? m[1] : null;
    }

    list.innerHTML = data.map(v => {
      const code = igShortcode(v.video_url);
      const embedUrl = code ? `https://www.instagram.com/p/${code}/embed/` : null;
      return `
      <div class="bg-brand-card border border-brand-border rounded-xl overflow-hidden">
        <div style="position:relative;padding-bottom:120%;overflow:hidden;">
          ${embedUrl
            ? `<iframe src="${embedUrl}" style="position:absolute;top:0;left:0;width:100%;height:100%;border:none;" scrolling="no" allowtransparency frameborder="0" loading="lazy"></iframe>`
            : `<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;" class="text-brand-muted text-xs">Link inválido</div>`}
        </div>
        <div class="p-4 border-t border-brand-border flex items-center justify-between gap-2">
          <div class="min-w-0">
            <p class="font-semibold text-brand-white text-sm truncate">${v.title}</p>
            ${v.category && v.category !== 'general' ? `<p class="text-brand-blue text-xs">${v.category}</p>` : ''}
          </div>
          <div class="flex items-center gap-3 shrink-0">
            ${code ? `<a href="https://www.instagram.com/reel/${code}/" target="_blank" class="text-brand-muted hover:text-[#E1306C] transition-colors" title="Ver en Instagram">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>` : ''}
            <button class="delete-video text-red-400/60 hover:text-red-400 transition-colors" data-id="${v.id}" title="Eliminar">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
        </div>
      </div>`;
    }).join('');

    // Thumbnail change
    list.querySelectorAll('.thumb-input').forEach(inp => {
      inp.addEventListener('change', async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        const id = (inp as HTMLElement).dataset.id!;
        const label = inp.closest('label')!;
        const loading = label.querySelector('.thumb-loading') as HTMLElement;
        loading.classList.remove('hidden');
        loading.classList.add('flex');
        try {
          const thumbnail_url = await uploadFile(file);
          await fetch('/api/admin/videos', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, thumbnail_url }) });
          await loadVideos();
        } catch { loading.classList.add('hidden'); loading.classList.remove('flex'); }
      });
    });

    // Delete
    list.querySelectorAll('.delete-video').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Eliminar este video?')) return;
        const id = (btn as HTMLElement).dataset.id!;
        await fetch('/api/admin/videos', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) });
        await loadVideos();
      });
    });
  }

  $('refreshVideos').addEventListener('click', loadVideos);

  // Validar URL de Instagram en tiempo real
  $('instagramUrlInput').addEventListener('input', (e) => {
    const url = (e.target as HTMLInputElement).value.trim();
    const validation = $('urlValidation');
    if (!url) { validation.classList.add('hidden'); return; }
    const match = url.match(/(?:reel|p)\/([A-Za-z0-9_-]+)/);
    validation.classList.remove('hidden');
    if (match) {
      validation.textContent = '✓ Link válido — shortcode: ' + match[1];
      validation.className = 'text-xs mt-1.5 text-green-400';
    } else {
      validation.textContent = '✗ No parece un link de Instagram válido';
      validation.className = 'text-xs mt-1.5 text-red-400';
    }
  });

  $('videoForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = $('videoSubmitBtn') as HTMLButtonElement;
    const successEl = $('videoSuccess');
    const errorEl = $('videoError');

    const instagram_url = (form.querySelector('[name=instagram_url]') as HTMLInputElement).value.trim();
    if (!instagram_url.match(/(?:reel|p)\/([A-Za-z0-9_-]+)/)) {
      errorEl.textContent = 'El link no es un URL de Instagram válido.';
      errorEl.classList.remove('hidden');
      return;
    }

    btn.disabled = true;
    successEl.classList.add('hidden');
    errorEl.classList.add('hidden');

    try {
      const res = await fetch('/api/admin/videos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: (form.querySelector('[name=title]') as HTMLInputElement).value,
          category: (form.querySelector('[name=category]') as HTMLInputElement).value,
          description: '',
          video_url: instagram_url,
          thumbnail_url: null,
        }),
      });
      if (!res.ok) throw new Error('Error al guardar: ' + res.status);

      form.reset();
      $('urlValidation').classList.add('hidden');
      successEl.classList.remove('hidden');
      setTimeout(() => successEl.classList.add('hidden'), 4000);
      await loadVideos();
    } catch (err) {
      errorEl.textContent = String(err);
      errorEl.classList.remove('hidden');
    }
    btn.disabled = false;
  });

  // ── Photos ────────────────────────────────────────────────────────────────
  async function loadPhotos() {
    const list = $('photosList');
    const res = await fetch('/api/admin/photos');
    const data: any[] = res.ok ? await res.json() : [];

    if (!data.length) {
      list.innerHTML = '<p class="col-span-full text-brand-muted text-sm py-8 text-center">No hay fotos aún.</p>';
      return;
    }

    list.innerHTML = data.map(p => `
      <div class="relative group">
        <img src="${p.photo_url}" alt="${p.title}" class="w-full aspect-square object-cover rounded-xl border border-brand-border" loading="lazy"/>
        <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity rounded-xl flex items-end p-3">
          <div class="w-full">
            <p class="text-white text-xs font-medium truncate">${p.title}</p>
            <button class="delete-photo mt-1 text-red-400 text-xs flex items-center gap-1" data-id="${p.id}">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              Eliminar
            </button>
          </div>
        </div>
      </div>
    `).join('');

    list.querySelectorAll('.delete-photo').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Eliminar esta foto?')) return;
        await fetch('/api/admin/photos', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: (btn as HTMLElement).dataset.id }) });
        await loadPhotos();
      });
    });
  }

  $('refreshPhotos').addEventListener('click', loadPhotos);

  $('photoForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = $('photoSubmitBtn') as HTMLButtonElement;
    const progress = $('photoProgress');
    const progressBar = $('photoProgressBar') as HTMLElement;
    const progressText = $('photoProgressText');
    const successEl = $('photoSuccess');
    const errorEl = $('photoError');

    btn.disabled = true;
    successEl.classList.add('hidden');
    errorEl.classList.add('hidden');
    progress.classList.remove('hidden');

    const files = Array.from((form.querySelector('#photoFileInput') as HTMLInputElement).files ?? []);
    const title = (form.querySelector('[name=title]') as HTMLInputElement).value;

    try {
      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        progressText.textContent = `Subiendo ${i + 1} de ${files.length}...`;
        const photo_url = await uploadFile(file, (pct) => {
          progressBar.style.width = ((i / files.length) * 100 + pct / files.length) + '%';
        });
        await fetch('/api/admin/photos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title: files.length > 1 ? `${title} ${i + 1}` : title, photo_url }),
        });
      }

      form.reset();
      $('photoFileName').textContent = 'Elegir imagen(es)';
      progress.classList.add('hidden');
      progressBar.style.width = '0%';
      successEl.classList.remove('hidden');
      setTimeout(() => successEl.classList.add('hidden'), 4000);
      await loadPhotos();
    } catch (err) {
      progress.classList.add('hidden');
      errorEl.textContent = String(err);
      errorEl.classList.remove('hidden');
    }
    btn.disabled = false;
  });

  // ── Brands ────────────────────────────────────────────────────────────────
  async function loadBrands() {
    const list = $('brandsList');
    const res = await fetch('/api/admin/brands');
    const data: any[] = res.ok ? await res.json() : [];

    if (!data.length) {
      list.innerHTML = '<p class="col-span-full text-brand-muted text-sm py-8 text-center">No hay marcas aún.</p>';
      return;
    }

    list.innerHTML = data.map(b => `
      <div class="bg-brand-card border border-brand-border rounded-xl p-4 flex flex-col items-center gap-3 group hover:border-brand-blue/30 transition-all">
        <div class="w-16 h-16 flex items-center justify-center">
          ${b.logo_url
            ? `<img src="${b.logo_url}" alt="${b.name}" class="w-full h-full object-contain" loading="lazy"/>`
            : `<div class="w-full h-full bg-brand-dark rounded-lg flex items-center justify-center text-brand-muted text-xs text-center font-medium p-2">${b.name}</div>`}
        </div>
        <p class="text-brand-white text-xs font-medium text-center truncate w-full">${b.name}</p>
        <button class="delete-brand text-red-400/50 hover:text-red-400 text-xs transition-colors" data-id="${b.id}">Eliminar</button>
      </div>
    `).join('');

    list.querySelectorAll('.delete-brand').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Eliminar esta marca?')) return;
        await fetch('/api/admin/brands', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: (btn as HTMLElement).dataset.id }) });
        await loadBrands();
      });
    });
  }

  $('refreshBrands').addEventListener('click', loadBrands);

  $('brandForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = $('brandSubmitBtn') as HTMLButtonElement;
    const errorEl = $('brandError');
    const successEl = $('brandSuccess');

    btn.disabled = true;
    errorEl.classList.add('hidden');
    successEl.classList.add('hidden');

    try {
      const logoFile = (form.querySelector('#logoFileInput') as HTMLInputElement).files?.[0];
      let logo_url: string | null = null;
      if (logoFile) {
        logo_url = await uploadFile(logoFile);
      }

      await fetch('/api/admin/brands', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: (form.querySelector('[name=name]') as HTMLInputElement).value,
          website_url: (form.querySelector('[name=websiteUrl]') as HTMLInputElement).value,
          logo_url,
        }),
      });

      form.reset();
      $('logoFileName').textContent = 'Elegir logo';
      successEl.classList.remove('hidden');
      setTimeout(() => successEl.classList.add('hidden'), 4000);
      await loadBrands();
    } catch (err) {
      errorEl.textContent = String(err);
      errorEl.classList.remove('hidden');
    }
    btn.disabled = false;
  });

  // ── Perfil ─────────────────────────────────────────────────────────────────
  async function loadProfileConfig() {
    const res = await fetch('/api/admin/config');
    if (!res.ok) return;
    const cfg = await res.json();
    if (cfg.about_photo_url) {
      const preview = $('profilePhotoPreview');
      preview.innerHTML = `<img src="${cfg.about_photo_url}" class="w-full h-full object-cover"/>`;
    }
    if (cfg.about_name) ($('profileName') as HTMLInputElement).value = cfg.about_name;
    if (cfg.about_bio) ($('profileBio') as HTMLTextAreaElement).value = cfg.about_bio;
  }

  function previewProfileFile(file: File) {
    if (!file || !file.type.startsWith('image/')) return;
    $('profilePhotoName').textContent = file.name;
    ($('uploadProfileBtn') as HTMLButtonElement).disabled = false;
    const reader = new FileReader();
    reader.onload = (ev) => {
      $('profilePhotoPreview').innerHTML = `<img src="${ev.target!.result}" class="w-full h-full object-cover"/>`;
    };
    reader.readAsDataURL(file);
  }

  $('profilePhotoInput').addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) previewProfileFile(file);
  });

  // Drag & drop
  const dropZone = $('profileDropZone');
  dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-brand-blue', 'bg-brand-blue/5');
    dropZone.classList.remove('border-brand-border');
  });
  dropZone.addEventListener('dragleave', () => {
    dropZone.classList.remove('border-brand-blue', 'bg-brand-blue/5');
    dropZone.classList.add('border-brand-border');
  });
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-brand-blue', 'bg-brand-blue/5');
    dropZone.classList.add('border-brand-border');
    const file = e.dataTransfer?.files?.[0];
    if (file) {
      const dt = new DataTransfer();
      dt.items.add(file);
      ($('profilePhotoInput') as HTMLInputElement).files = dt.files;
      previewProfileFile(file);
    }
  });

  $('uploadProfileBtn').addEventListener('click', async () => {
    const file = ($('profilePhotoInput') as HTMLInputElement).files?.[0];
    if (!file) return;
    const btn = $('uploadProfileBtn') as HTMLButtonElement;
    const progress = $('profileProgress');
    const progressBar = $('profileProgressBar') as HTMLElement;
    const progressText = $('profileProgressText');
    const errorEl = $('profileError');
    const successEl = $('profileSuccess');

    btn.disabled = true;
    errorEl.classList.add('hidden');
    successEl.classList.add('hidden');
    progress.classList.remove('hidden');

    try {
      const url = await uploadFile(file, (pct) => {
        progressBar.style.width = pct + '%';
        progressText.textContent = `Subiendo... ${Math.round(pct)}%`;
      });
      await fetch('/api/admin/config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ about_photo_url: url }),
      });
      progress.classList.add('hidden');
      progressBar.style.width = '0%';
      successEl.classList.remove('hidden');
      setTimeout(() => successEl.classList.add('hidden'), 5000);
    } catch (err) {
      progress.classList.add('hidden');
      errorEl.textContent = String(err);
      errorEl.classList.remove('hidden');
    }
    btn.disabled = false;
  });

  $('saveProfileInfoBtn').addEventListener('click', async () => {
    const btn = $('saveProfileInfoBtn') as HTMLButtonElement;
    const successEl = $('profileInfoSuccess');
    btn.disabled = true;
    try {
      await fetch('/api/admin/config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          about_name: ($('profileName') as HTMLInputElement).value,
          about_bio: ($('profileBio') as HTMLTextAreaElement).value,
        }),
      });
      successEl.classList.remove('hidden');
      setTimeout(() => successEl.classList.add('hidden'), 3000);
    } catch {}
    btn.disabled = false;
  });

  loadProfileConfig();

  // ── APARIENCIA ──
  async function loadThemeConfig() {
    try {
      const res = await fetch('/api/admin/config');
      const cfg = await res.json();
      applyThemeUI(cfg.theme || 'light');
    } catch {}
  }

  function applyThemeUI(theme: string) {
    const ids = ['themeLight', 'themeDark', 'themeMidnight', 'themeArena'];
    const map: Record<string, string> = { light: 'themeLight', dark: 'themeDark', midnight: 'themeMidnight', arena: 'themeArena' };
    const activeClass = ['border-brand-blue', 'bg-brand-blue/5'];
    const inactiveClass = ['border-brand-border', 'bg-transparent'];
    ids.forEach(id => {
      const el = $(id);
      if (!el) return;
      if (id === map[theme]) {
        el.classList.add(...activeClass);
        el.classList.remove(...inactiveClass);
      } else {
        el.classList.add(...inactiveClass);
        el.classList.remove(...activeClass);
      }
    });
  }

  (window as any).setTheme = async (theme: string) => {
    applyThemeUI(theme);
    const statusEl = $('themeStatus');
    const errorEl = $('themeError');
    try {
      const res = await fetch('/api/admin/config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ theme }),
      });
      if (!res.ok) throw new Error('Error al guardar');
      statusEl!.classList.remove('hidden');
      setTimeout(() => statusEl!.classList.add('hidden'), 4000);
    } catch (e: any) {
      errorEl!.textContent = e.message;
      errorEl!.classList.remove('hidden');
      setTimeout(() => errorEl!.classList.add('hidden'), 3000);
    }
  };

  loadThemeConfig();
</script>
