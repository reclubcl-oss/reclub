---
import Layout from '../../layouts/Layout.astro';
import { checkAuth } from '../../lib/auth';

const authed = checkAuth(Astro.request);
---

<Layout title="Admin — ReClub">
  <!-- LOGIN -->
  <div id="loginScreen" class={`min-h-screen flex items-center justify-center p-6 bg-brand-black ${authed ? 'hidden' : ''}`}>
    <div class="w-full max-w-sm">
      <div class="text-center mb-8">
        <div class="w-12 h-12 bg-brand-blue/10 border border-brand-blue/30 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
        </div>
        <h1 class="text-2xl font-black text-brand-white">Panel Admin</h1>
        <p class="text-brand-muted text-sm mt-1">ReClub Agencia Digital</p>
      </div>
      <div class="bg-brand-card border border-brand-border rounded-2xl p-6">
        <div id="loginError" class="hidden mb-4 bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-xl"></div>
        <form id="loginForm" class="space-y-4">
          <div>
            <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Contraseña</label>
            <input type="password" id="loginPassword" required autocomplete="current-password"
              class="w-full bg-brand-dark border border-brand-border rounded-xl px-4 py-3 text-brand-white focus:border-brand-blue outline-none transition-colors placeholder:text-brand-muted/40"
              placeholder="••••••••"
            />
          </div>
          <button type="submit" id="loginBtn"
            class="w-full bg-brand-blue hover:bg-brand-blue-dark text-white py-3 rounded-xl font-semibold transition-colors disabled:opacity-50"
          >Entrar</button>
        </form>
      </div>
      <p class="text-center mt-6">
        <a href="/portafolio" class="text-brand-muted text-sm hover:text-brand-white transition-colors">← Ver portafolio</a>
      </p>
    </div>
  </div>

  <!-- DASHBOARD -->
  <div id="adminDashboard" class={`min-h-screen bg-brand-black ${authed ? '' : 'hidden'}`}>
    <header class="sticky top-0 z-40 border-b border-brand-border bg-brand-black/90 backdrop-blur-md px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 bg-brand-blue/10 border border-brand-blue/30 rounded-xl flex items-center justify-center">
          <svg class="w-4 h-4 text-brand-blue" fill="currentColor" viewBox="0 0 24 24">
            <path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8 12.5v-9l6 4.5-6 4.5z"/>
          </svg>
        </div>
        <div>
          <p class="font-black text-brand-white text-sm leading-none">Admin</p>
          <p class="text-brand-muted text-xs">ReClub</p>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <a href="/portafolio" target="_blank" class="text-brand-muted hover:text-brand-white text-sm transition-colors hidden sm:flex items-center gap-1">
          Ver portafolio
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
        <button id="logoutBtn" class="text-brand-muted hover:text-red-400 text-sm transition-colors flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
          </svg>
          Salir
        </button>
      </div>
    </header>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
      <!-- Tabs -->
      <div class="flex gap-2 mb-8 border-b border-brand-border pb-4 flex-wrap">
        <button class="tab-btn active" data-tab="videos">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/></svg>
          Videos
        </button>
        <button class="tab-btn" data-tab="photos">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          Fotos
        </button>
        <button class="tab-btn" data-tab="brands">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          Marcas
        </button>
      </div>

      <!-- ===== VIDEOS TAB ===== -->
      <div id="tab-videos" class="tab-content">
        <div class="bg-brand-card border border-brand-border rounded-2xl p-6 mb-8">
          <h2 class="font-bold text-brand-white mb-1">Subir nuevo video</h2>
          <p class="text-brand-muted text-xs mb-6">Formatos: MP4, MOV, WebM · Hasta 500 MB</p>
          <form id="videoForm" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Título *</label>
                <input type="text" name="title" required class="w-full bg-brand-dark border border-brand-border rounded-xl px-4 py-3 text-brand-white focus:border-brand-blue outline-none transition-colors text-sm" placeholder="Nombre del proyecto"/>
              </div>
              <div>
                <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Categoría</label>
                <input type="text" name="category" class="w-full bg-brand-dark border border-brand-border rounded-xl px-4 py-3 text-brand-white focus:border-brand-blue outline-none transition-colors text-sm" placeholder="Redes Sociales, Publicidad..."/>
              </div>
            </div>
            <div>
              <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Descripción</label>
              <textarea name="description" rows="2" class="w-full bg-brand-dark border border-brand-border rounded-xl px-4 py-3 text-brand-white focus:border-brand-blue outline-none transition-colors resize-none text-sm" placeholder="Descripción breve..."></textarea>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Archivo de video *</label>
                <label class="block w-full bg-brand-dark border border-dashed border-brand-border hover:border-brand-blue/50 rounded-xl px-4 py-4 cursor-pointer transition-colors group">
                  <input type="file" name="videoFile" accept="video/*" required class="hidden" id="videoFileInput"/>
                  <div class="flex items-center gap-3">
                    <svg class="w-8 h-8 text-brand-muted/50 group-hover:text-brand-blue/70 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                    <div>
                      <p id="videoFileName" class="text-brand-muted text-sm">Elegir video</p>
                      <p class="text-brand-muted/40 text-xs">MP4, MOV, WebM</p>
                    </div>
                  </div>
                </label>
              </div>
              <div>
                <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Thumbnail <span class="normal-case font-normal">(opcional)</span></label>
                <label class="block w-full bg-brand-dark border border-dashed border-brand-border hover:border-brand-blue/50 rounded-xl px-4 py-4 cursor-pointer transition-colors group">
                  <input type="file" name="thumbnailFile" accept="image/*" class="hidden" id="thumbFileInput"/>
                  <div class="flex items-center gap-3">
                    <svg class="w-8 h-8 text-brand-muted/50 group-hover:text-brand-blue/70 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    <div>
                      <p id="thumbFileName" class="text-brand-muted text-sm">Elegir imagen</p>
                      <p class="text-brand-muted/40 text-xs">JPG, PNG, WebP</p>
                    </div>
                  </div>
                </label>
              </div>
            </div>
            <div id="videoProgress" class="hidden space-y-2">
              <div class="h-1.5 bg-brand-dark rounded-full overflow-hidden">
                <div id="videoProgressBar" class="h-full bg-gradient-to-r from-brand-blue to-brand-purple rounded-full transition-all duration-300 w-0"></div>
              </div>
              <p id="videoProgressText" class="text-brand-muted text-xs">Subiendo...</p>
            </div>
            <div id="videoSuccess" class="hidden bg-green-500/10 border border-green-500/30 text-green-400 text-sm px-4 py-3 rounded-xl">✓ Video subido con éxito</div>
            <div id="videoError" class="hidden bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-xl"></div>
            <button type="submit" id="videoSubmitBtn" class="bg-brand-blue hover:bg-brand-blue-dark text-white px-8 py-3 rounded-xl font-semibold transition-colors text-sm disabled:opacity-50">Subir Video</button>
          </form>
        </div>
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-bold text-brand-white">Videos publicados</h2>
          <button id="refreshVideos" class="text-brand-muted hover:text-brand-white text-xs transition-colors">↻ Actualizar</button>
        </div>
        <div id="videosList" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <div class="col-span-full text-brand-muted text-sm py-8 text-center">Cargando...</div>
        </div>
      </div>

      <!-- ===== PHOTOS TAB ===== -->
      <div id="tab-photos" class="tab-content hidden">
        <div class="bg-brand-card border border-brand-border rounded-2xl p-6 mb-8">
          <h2 class="font-bold text-brand-white mb-1">Subir nueva foto</h2>
          <p class="text-brand-muted text-xs mb-6">Formatos: JPG, PNG, WebP</p>
          <form id="photoForm" class="space-y-4">
            <div>
              <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Título *</label>
              <input type="text" name="title" required class="w-full bg-brand-dark border border-brand-border rounded-xl px-4 py-3 text-brand-white focus:border-brand-blue outline-none transition-colors text-sm" placeholder="Nombre del proyecto"/>
            </div>
            <div>
              <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Archivo *</label>
              <label class="block w-full bg-brand-dark border border-dashed border-brand-border hover:border-brand-blue/50 rounded-xl px-4 py-4 cursor-pointer transition-colors group">
                <input type="file" name="photoFile" accept="image/*" required class="hidden" id="photoFileInput" multiple/>
                <div class="flex items-center gap-3">
                  <svg class="w-8 h-8 text-brand-muted/50 group-hover:text-brand-blue/70 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  <div>
                    <p id="photoFileName" class="text-brand-muted text-sm">Elegir imagen(es)</p>
                    <p class="text-brand-muted/40 text-xs">Puedes seleccionar varias a la vez</p>
                  </div>
                </div>
              </label>
            </div>
            <div id="photoProgress" class="hidden space-y-2">
              <div class="h-1.5 bg-brand-dark rounded-full overflow-hidden">
                <div id="photoProgressBar" class="h-full bg-gradient-to-r from-brand-blue to-brand-purple rounded-full transition-all duration-300 w-0"></div>
              </div>
              <p id="photoProgressText" class="text-brand-muted text-xs">Subiendo...</p>
            </div>
            <div id="photoSuccess" class="hidden bg-green-500/10 border border-green-500/30 text-green-400 text-sm px-4 py-3 rounded-xl">✓ Foto(s) subida(s) con éxito</div>
            <div id="photoError" class="hidden bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-xl"></div>
            <button type="submit" id="photoSubmitBtn" class="bg-brand-blue hover:bg-brand-blue-dark text-white px-8 py-3 rounded-xl font-semibold transition-colors text-sm disabled:opacity-50">Subir Foto(s)</button>
          </form>
        </div>
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-bold text-brand-white">Fotos publicadas</h2>
          <button id="refreshPhotos" class="text-brand-muted hover:text-brand-white text-xs transition-colors">↻ Actualizar</button>
        </div>
        <div id="photosList" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          <div class="col-span-full text-brand-muted text-sm py-8 text-center">Cargando...</div>
        </div>
      </div>

      <!-- ===== BRANDS TAB ===== -->
      <div id="tab-brands" class="tab-content hidden">
        <div class="bg-brand-card border border-brand-border rounded-2xl p-6 mb-8">
          <h2 class="font-bold text-brand-white mb-1">Agregar marca</h2>
          <p class="text-brand-muted text-xs mb-6">Aparece en la sección de marcas del portafolio</p>
          <form id="brandForm" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Nombre *</label>
                <input type="text" name="name" required class="w-full bg-brand-dark border border-brand-border rounded-xl px-4 py-3 text-brand-white focus:border-brand-blue outline-none transition-colors text-sm" placeholder="Nombre de la marca"/>
              </div>
              <div>
                <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Sitio web <span class="normal-case font-normal">(opcional)</span></label>
                <input type="url" name="websiteUrl" class="w-full bg-brand-dark border border-brand-border rounded-xl px-4 py-3 text-brand-white focus:border-brand-blue outline-none transition-colors text-sm" placeholder="https://..."/>
              </div>
            </div>
            <div>
              <label class="block text-xs text-brand-muted mb-2 font-medium uppercase tracking-wider">Logo <span class="normal-case font-normal">(PNG, SVG)</span></label>
              <label class="block w-full max-w-xs bg-brand-dark border border-dashed border-brand-border hover:border-brand-blue/50 rounded-xl px-4 py-4 cursor-pointer transition-colors group">
                <input type="file" name="logoFile" accept="image/*" class="hidden" id="logoFileInput"/>
                <div class="flex items-center gap-3">
                  <svg class="w-8 h-8 text-brand-muted/50 group-hover:text-brand-blue/70 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  <div>
                    <p id="logoFileName" class="text-brand-muted text-sm">Elegir logo</p>
                    <p class="text-brand-muted/40 text-xs">PNG, SVG, WebP</p>
                  </div>
                </div>
              </label>
            </div>
            <div id="brandError" class="hidden bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-xl"></div>
            <div id="brandSuccess" class="hidden bg-green-500/10 border border-green-500/30 text-green-400 text-sm px-4 py-3 rounded-xl">✓ Marca agregada</div>
            <button type="submit" id="brandSubmitBtn" class="bg-brand-blue hover:bg-brand-blue-dark text-white px-8 py-3 rounded-xl font-semibold transition-colors text-sm disabled:opacity-50">Agregar Marca</button>
          </form>
        </div>
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-bold text-brand-white">Marcas</h2>
          <button id="refreshBrands" class="text-brand-muted hover:text-brand-white text-xs transition-colors">↻ Actualizar</button>
        </div>
        <div id="brandsList" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          <div class="col-span-full text-brand-muted text-sm py-8 text-center">Cargando...</div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    transition: all 0.15s;
    color: #94A3B8;
    background: transparent;
    border: 1px solid transparent;
  }
  .tab-btn:hover { color: #F8FAFC; border-color: #1E293B; }
  .tab-btn.active { background: #3B82F6; color: white; border-color: transparent; }
</style>

<script>
  import { upload } from '@vercel/blob/client';

  const $ = (id: string) => document.getElementById(id)!;

  // ── Auth ──────────────────────────────────────────────────────────────────
  const isLoggedIn = !$('loginScreen').classList.contains('hidden') === false;

  $('loginForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = $('loginBtn') as HTMLButtonElement;
    const err = $('loginError');
    btn.disabled = true;
    btn.textContent = 'Entrando...';
    err.classList.add('hidden');

    const password = ($('loginPassword') as HTMLInputElement).value;
    const res = await fetch('/api/admin/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password }),
    });

    if (res.ok) {
      $('loginScreen').classList.add('hidden');
      $('adminDashboard').classList.remove('hidden');
      await Promise.all([loadVideos(), loadPhotos(), loadBrands()]);
    } else {
      const { error } = await res.json();
      err.textContent = error ?? 'Contraseña incorrecta';
      err.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Entrar';
    }
  });

  $('logoutBtn').addEventListener('click', async () => {
    await fetch('/api/admin/logout', { method: 'POST' });
    $('adminDashboard').classList.add('hidden');
    $('loginScreen').classList.remove('hidden');
  });

  // Load on mount if already authed
  if (!$('adminDashboard').classList.contains('hidden')) {
    Promise.all([loadVideos(), loadPhotos(), loadBrands()]);
  }

  // ── Tabs ──────────────────────────────────────────────────────────────────
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
      btn.classList.add('active');
      $(`tab-${(btn as HTMLElement).dataset.tab}`).classList.remove('hidden');
    });
  });

  // ── File name labels ──────────────────────────────────────────────────────
  function watchFile(inputId: string, labelId: string) {
    document.getElementById(inputId)?.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      $(labelId).textContent = files?.length === 1 ? files[0].name : files ? `${files.length} archivos` : 'Elegir archivo';
    });
  }
  watchFile('videoFileInput', 'videoFileName');
  watchFile('thumbFileInput', 'thumbFileName');
  watchFile('logoFileInput', 'logoFileName');
  watchFile('photoFileInput', 'photoFileName');

  // ── Upload to Vercel Blob ─────────────────────────────────────────────────
  async function uploadFile(file: File, onProgress?: (pct: number) => void): Promise<string> {
    const ext = file.name.split('.').pop() ?? 'bin';
    const filename = `${Date.now()}-${Math.random().toString(36).slice(2)}.${ext}`;
    const blob = await upload(filename, file, {
      access: 'public',
      handleUploadUrl: '/api/blob',
      onUploadProgress: ({ percentage }) => onProgress?.(percentage),
    });
    return blob.url;
  }

  // ── Videos ────────────────────────────────────────────────────────────────
  async function loadVideos() {
    const list = $('videosList');
    const res = await fetch('/api/admin/videos');
    const data: any[] = res.ok ? await res.json() : [];

    if (!data.length) {
      list.innerHTML = '<p class="col-span-full text-brand-muted text-sm py-8 text-center">No hay videos aún.</p>';
      return;
    }

    list.innerHTML = data.map(v => `
      <div class="bg-brand-card border border-brand-border rounded-xl overflow-hidden" data-video-id="${v.id}">
        <label class="block aspect-video bg-brand-dark relative overflow-hidden cursor-pointer group" title="Clic para cambiar portada">
          <input type="file" accept="image/*" class="hidden thumb-input" data-id="${v.id}" />
          ${v.thumbnail_url
            ? `<img src="${v.thumbnail_url}" class="w-full h-full object-cover" loading="lazy" />`
            : `<div class="w-full h-full flex items-center justify-center"><svg class="w-10 h-10 text-brand-muted/30" fill="currentColor" viewBox="0 0 24 24"><path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/></svg></div>`}
          <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center gap-1">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span class="text-white text-xs font-semibold">Cambiar portada</span>
          </div>
          <div class="thumb-loading absolute inset-0 bg-black/70 hidden items-center justify-center">
            <div class="w-6 h-6 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
          </div>
        </label>
        <div class="p-4">
          <p class="font-semibold text-brand-white text-sm truncate">${v.title}</p>
          ${v.category && v.category !== 'general' ? `<p class="text-brand-blue text-xs mt-0.5">${v.category}</p>` : ''}
          <button class="delete-video mt-3 text-red-400/60 hover:text-red-400 text-xs transition-colors flex items-center gap-1" data-id="${v.id}">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            Eliminar
          </button>
        </div>
      </div>
    `).join('');

    // Thumbnail change
    list.querySelectorAll('.thumb-input').forEach(inp => {
      inp.addEventListener('change', async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        const id = (inp as HTMLElement).dataset.id!;
        const label = inp.closest('label')!;
        const loading = label.querySelector('.thumb-loading') as HTMLElement;
        loading.classList.remove('hidden');
        loading.classList.add('flex');
        try {
          const thumbnail_url = await uploadFile(file);
          await fetch('/api/admin/videos', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, thumbnail_url }) });
          await loadVideos();
        } catch { loading.classList.add('hidden'); loading.classList.remove('flex'); }
      });
    });

    // Delete
    list.querySelectorAll('.delete-video').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Eliminar este video?')) return;
        const id = (btn as HTMLElement).dataset.id!;
        await fetch('/api/admin/videos', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) });
        await loadVideos();
      });
    });
  }

  $('refreshVideos').addEventListener('click', loadVideos);

  $('videoForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = $('videoSubmitBtn') as HTMLButtonElement;
    const progress = $('videoProgress');
    const progressBar = $('videoProgressBar') as HTMLElement;
    const progressText = $('videoProgressText');
    const successEl = $('videoSuccess');
    const errorEl = $('videoError');

    btn.disabled = true;
    successEl.classList.add('hidden');
    errorEl.classList.add('hidden');
    progress.classList.remove('hidden');

    try {
      const videoFile = (form.querySelector('#videoFileInput') as HTMLInputElement).files![0];
      const thumbFile = (form.querySelector('#thumbFileInput') as HTMLInputElement).files?.[0];

      progressText.textContent = 'Subiendo video...';
      const video_url = await uploadFile(videoFile, (pct) => {
        progressBar.style.width = pct + '%';
        progressText.textContent = `Subiendo video... ${Math.round(pct)}%`;
      });

      let thumbnail_url: string | null = null;
      if (thumbFile) {
        progressText.textContent = 'Subiendo thumbnail...';
        progressBar.style.width = '0%';
        thumbnail_url = await uploadFile(thumbFile, (pct) => {
          progressBar.style.width = pct + '%';
        });
      }

      progressBar.style.width = '100%';
      progressText.textContent = 'Guardando...';

      await fetch('/api/admin/videos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: (form.querySelector('[name=title]') as HTMLInputElement).value,
          description: (form.querySelector('[name=description]') as HTMLTextAreaElement).value,
          category: (form.querySelector('[name=category]') as HTMLInputElement).value,
          video_url,
          thumbnail_url,
        }),
      });

      form.reset();
      $('videoFileName').textContent = 'Elegir video';
      $('thumbFileName').textContent = 'Elegir imagen';
      progress.classList.add('hidden');
      progressBar.style.width = '0%';
      successEl.classList.remove('hidden');
      setTimeout(() => successEl.classList.add('hidden'), 4000);
      await loadVideos();
    } catch (err) {
      progress.classList.add('hidden');
      errorEl.textContent = String(err);
      errorEl.classList.remove('hidden');
    }
    btn.disabled = false;
  });

  // ── Photos ────────────────────────────────────────────────────────────────
  async function loadPhotos() {
    const list = $('photosList');
    const res = await fetch('/api/admin/photos');
    const data: any[] = res.ok ? await res.json() : [];

    if (!data.length) {
      list.innerHTML = '<p class="col-span-full text-brand-muted text-sm py-8 text-center">No hay fotos aún.</p>';
      return;
    }

    list.innerHTML = data.map(p => `
      <div class="relative group">
        <img src="${p.photo_url}" alt="${p.title}" class="w-full aspect-square object-cover rounded-xl border border-brand-border" loading="lazy"/>
        <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity rounded-xl flex items-end p-3">
          <div class="w-full">
            <p class="text-white text-xs font-medium truncate">${p.title}</p>
            <button class="delete-photo mt-1 text-red-400 text-xs flex items-center gap-1" data-id="${p.id}">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              Eliminar
            </button>
          </div>
        </div>
      </div>
    `).join('');

    list.querySelectorAll('.delete-photo').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Eliminar esta foto?')) return;
        await fetch('/api/admin/photos', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: (btn as HTMLElement).dataset.id }) });
        await loadPhotos();
      });
    });
  }

  $('refreshPhotos').addEventListener('click', loadPhotos);

  $('photoForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = $('photoSubmitBtn') as HTMLButtonElement;
    const progress = $('photoProgress');
    const progressBar = $('photoProgressBar') as HTMLElement;
    const progressText = $('photoProgressText');
    const successEl = $('photoSuccess');
    const errorEl = $('photoError');

    btn.disabled = true;
    successEl.classList.add('hidden');
    errorEl.classList.add('hidden');
    progress.classList.remove('hidden');

    const files = Array.from((form.querySelector('#photoFileInput') as HTMLInputElement).files ?? []);
    const title = (form.querySelector('[name=title]') as HTMLInputElement).value;

    try {
      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        progressText.textContent = `Subiendo ${i + 1} de ${files.length}...`;
        const photo_url = await uploadFile(file, (pct) => {
          progressBar.style.width = ((i / files.length) * 100 + pct / files.length) + '%';
        });
        await fetch('/api/admin/photos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title: files.length > 1 ? `${title} ${i + 1}` : title, photo_url }),
        });
      }

      form.reset();
      $('photoFileName').textContent = 'Elegir imagen(es)';
      progress.classList.add('hidden');
      progressBar.style.width = '0%';
      successEl.classList.remove('hidden');
      setTimeout(() => successEl.classList.add('hidden'), 4000);
      await loadPhotos();
    } catch (err) {
      progress.classList.add('hidden');
      errorEl.textContent = String(err);
      errorEl.classList.remove('hidden');
    }
    btn.disabled = false;
  });

  // ── Brands ────────────────────────────────────────────────────────────────
  async function loadBrands() {
    const list = $('brandsList');
    const res = await fetch('/api/admin/brands');
    const data: any[] = res.ok ? await res.json() : [];

    if (!data.length) {
      list.innerHTML = '<p class="col-span-full text-brand-muted text-sm py-8 text-center">No hay marcas aún.</p>';
      return;
    }

    list.innerHTML = data.map(b => `
      <div class="bg-brand-card border border-brand-border rounded-xl p-4 flex flex-col items-center gap-3 group hover:border-brand-blue/30 transition-all">
        <div class="w-16 h-16 flex items-center justify-center">
          ${b.logo_url
            ? `<img src="${b.logo_url}" alt="${b.name}" class="w-full h-full object-contain" loading="lazy"/>`
            : `<div class="w-full h-full bg-brand-dark rounded-lg flex items-center justify-center text-brand-muted text-xs text-center font-medium p-2">${b.name}</div>`}
        </div>
        <p class="text-brand-white text-xs font-medium text-center truncate w-full">${b.name}</p>
        <button class="delete-brand text-red-400/50 hover:text-red-400 text-xs transition-colors" data-id="${b.id}">Eliminar</button>
      </div>
    `).join('');

    list.querySelectorAll('.delete-brand').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Eliminar esta marca?')) return;
        await fetch('/api/admin/brands', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: (btn as HTMLElement).dataset.id }) });
        await loadBrands();
      });
    });
  }

  $('refreshBrands').addEventListener('click', loadBrands);

  $('brandForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = $('brandSubmitBtn') as HTMLButtonElement;
    const errorEl = $('brandError');
    const successEl = $('brandSuccess');

    btn.disabled = true;
    errorEl.classList.add('hidden');
    successEl.classList.add('hidden');

    try {
      const logoFile = (form.querySelector('#logoFileInput') as HTMLInputElement).files?.[0];
      let logo_url: string | null = null;
      if (logoFile) {
        logo_url = await uploadFile(logoFile);
      }

      await fetch('/api/admin/brands', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: (form.querySelector('[name=name]') as HTMLInputElement).value,
          website_url: (form.querySelector('[name=websiteUrl]') as HTMLInputElement).value,
          logo_url,
        }),
      });

      form.reset();
      $('logoFileName').textContent = 'Elegir logo';
      successEl.classList.remove('hidden');
      setTimeout(() => successEl.classList.add('hidden'), 4000);
      await loadBrands();
    } catch (err) {
      errorEl.textContent = String(err);
      errorEl.classList.remove('hidden');
    }
    btn.disabled = false;
  });
</script>
