---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import sql from '../../lib/db';

let videos: any[] = [];
let brands: any[] = [];

try {
  [videos, brands] = await Promise.all([
    sql`SELECT * FROM portfolio_videos ORDER BY sort_order, created_at DESC`,
    sql`SELECT * FROM portfolio_brands ORDER BY sort_order, created_at DESC`,
  ]);
} catch (_) {}

const totalBrands = brands.length;

function getInstaShortcode(url: string): string | null {
  const m = url?.match(/(?:reel|p)\/([A-Za-z0-9_-]+)/);
  return m ? m[1] : null;
}

function getEmbedUrl(url: string): string | null {
  const code = getInstaShortcode(url);
  return code ? `https://www.instagram.com/p/${code}/embed/` : null;
}
---

<Layout
  title="Portafolio | ReClub — Trabajos de Diseño Web y Contenido en Chile"
  description="Portafolio de ReClub: más de 60 marcas chilenas confían en nosotros. Videos de producción, reels de Instagram y logos de clientes reales en Santiago, Chile."
  canonical="https://reclubcl.com/portafolio"
>
  <Nav />
  <main>

    <!-- HERO -->
    <section class="relative flex flex-col items-center justify-center overflow-hidden bg-brand-black pt-20" style="min-height:100svh;">
      <div class="absolute inset-0 bg-[linear-gradient(rgba(30,41,59,0.2)_1px,transparent_1px),linear-gradient(90deg,rgba(30,41,59,0.2)_1px,transparent_1px)] bg-[size:60px_60px]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_50%_at_50%_-10%,rgba(59,130,246,0.12),transparent)]"></div>
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-brand-blue/8 rounded-full blur-3xl animate-blob"></div>
      <div class="absolute top-1/3 right-1/4 w-96 h-96 bg-brand-purple/8 rounded-full blur-3xl animate-blob animation-delay-2000"></div>

      <div class="relative z-10 max-w-5xl mx-auto px-4 text-center">
        <div class="inline-flex items-center gap-2 border border-brand-blue/25 bg-brand-blue/8 text-brand-blue text-xs px-4 py-2 rounded-full mb-10 tracking-wider uppercase font-medium" data-aos="fade-down">
          <span class="w-1.5 h-1.5 bg-brand-blue rounded-full animate-pulse"></span>
          Nuestro Trabajo
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold leading-[1.1] mb-6 tracking-tight" data-aos="fade-up" data-aos-delay="100">
          Resultados reales para<br />
          <span class="bg-gradient-to-r from-brand-blue to-brand-purple bg-clip-text text-transparent">
            marcas reales
          </span>
        </h1>

        <p class="text-brand-muted text-lg md:text-xl max-w-2xl mx-auto mb-12 leading-relaxed" data-aos="fade-up" data-aos-delay="200">
          Producción audiovisual y contenido digital que conecta marcas con su audiencia.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center w-full max-w-sm sm:max-w-none mx-auto" data-aos="fade-up" data-aos-delay="300">
          <a href="#videos" class="bg-gradient-to-r from-brand-blue to-brand-purple text-white px-10 py-4 rounded-xl font-semibold hover:scale-105 active:scale-95 transition-transform duration-200 shadow-lg shadow-brand-blue/20 text-center">
            Ver videos
          </a>
          <a href="/#contacto" class="border border-brand-border text-brand-white px-10 py-4 rounded-xl font-semibold hover:border-brand-blue/40 hover:bg-brand-blue/5 transition-all duration-200 text-center">
            Trabajemos juntos
          </a>
        </div>

        <div class="mt-20 grid grid-cols-2 gap-8 max-w-xs mx-auto" data-aos="fade-up" data-aos-delay="400">
          <div class="text-center">
            <p class="text-3xl font-bold text-brand-white">{totalBrands > 60 ? `${totalBrands}+` : '60+'}</p>
            <p class="text-brand-muted text-xs mt-1 tracking-wide uppercase">Marcas</p>
          </div>
          <div class="text-center border-l border-brand-border">
            <p class="text-3xl font-bold text-brand-white">5+</p>
            <p class="text-brand-muted text-xs mt-1 tracking-wide uppercase">Años</p>
          </div>
        </div>
      </div>

      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce opacity-40">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-brand-muted">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
        </svg>
      </div>
    </section>

    <!-- VIDEOS INSTAGRAM -->
    <section id="videos" class="py-16 sm:py-28 px-4 bg-brand-black">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-10 sm:mb-20" data-aos="fade-up">
          <p class="text-brand-blue text-xs font-semibold tracking-widest uppercase mb-4">Producción</p>
          <h2 class="text-2xl sm:text-3xl md:text-5xl font-bold text-brand-white mb-4 sm:mb-5">Nuestros Videos</h2>
          <p class="text-brand-muted text-sm sm:text-base max-w-xl mx-auto">Cada proyecto cuenta una historia. Aquí están las nuestras.</p>
          <div class="w-12 h-0.5 bg-gradient-to-r from-brand-blue to-brand-purple rounded mx-auto mt-6 sm:mt-8"></div>
        </div>

        {videos.length === 0 ? (
          <div class="text-center py-32 text-brand-muted">
            <svg class="w-14 h-14 mx-auto mb-4 opacity-20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
            <p class="text-lg font-medium">Videos próximamente</p>
            <p class="text-sm mt-2 opacity-60">Agrega videos desde el panel admin</p>
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 items-start">
            {videos.map((v, i) => {
              const embedUrl = getEmbedUrl(v.video_url);
              const shortcode = getInstaShortcode(v.video_url);
              return (
                <article
                  class="bg-brand-card border border-brand-border rounded-2xl overflow-hidden hover:border-brand-blue/40 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_40px_rgba(59,130,246,0.10)]"
                  data-aos="fade-up"
                  data-aos-delay={Math.min(i * 80, 400)}
                >
                  {embedUrl ? (
                    <div class="instagram-embed-wrapper" style="padding-bottom: 120%;">
                      <iframe
                        src={embedUrl}
                        class="instagram-embed-frame"
                        frameborder="0"
                        scrolling="no"
                        allowtransparency
                        allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
                        loading="lazy"
                      ></iframe>
                    </div>
                  ) : (
                    <div class="aspect-video bg-brand-dark flex items-center justify-center">
                      <p class="text-brand-muted text-xs">Link inválido</p>
                    </div>
                  )}
                  <div class="p-4 border-t border-brand-border flex items-center justify-between gap-3">
                    <div class="min-w-0">
                      <h3 class="font-semibold text-brand-white text-sm truncate">{v.title}</h3>
                      {v.category && v.category !== 'general' && (
                        <span class="text-xs text-brand-blue">{v.category}</span>
                      )}
                    </div>
                    {shortcode && (
                      <a
                        href={`https://www.instagram.com/reel/${shortcode}/`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="shrink-0 text-brand-muted hover:text-[#E1306C] transition-colors"
                        title="Ver en Instagram"
                      >
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                        </svg>
                      </a>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </div>
    </section>

    <!-- BRANDS -->
    <section id="marcas" class="py-16 sm:py-28 bg-brand-dark overflow-hidden">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-10 sm:mb-16" data-aos="fade-up">
          <p class="text-brand-blue text-xs font-semibold tracking-widest uppercase mb-4">Clientes</p>
          <h2 class="text-2xl sm:text-3xl md:text-5xl font-bold text-brand-white mb-4 sm:mb-5">
            {totalBrands > 60 ? `${totalBrands}+` : '60+'} marcas han confiado en ReClub
          </h2>
          <p class="text-brand-muted text-sm sm:text-base max-w-xl mx-auto">Empresas y emprendimientos que eligieron ReClub para crecer digitalmente.</p>
          <div class="w-12 h-0.5 bg-gradient-to-r from-brand-blue to-brand-purple rounded mx-auto mt-6 sm:mt-8"></div>
        </div>
      </div>

      {brands.length === 0 ? (
        <p class="text-center text-brand-muted py-16">Marcas próximamente</p>
      ) : (
        <div class="relative">
          <!-- fade edges -->
          <div class="absolute left-0 top-0 bottom-0 w-24 z-10 bg-gradient-to-r from-brand-dark to-transparent pointer-events-none"></div>
          <div class="absolute right-0 top-0 bottom-0 w-24 z-10 bg-gradient-to-l from-brand-dark to-transparent pointer-events-none"></div>

          <!-- Row 1 — left to right -->
          <div class="marquee-track mb-4" data-speed="35">
            <div class="marquee-inner flex gap-4">
              {[...brands, ...brands].map((b, i) => (
                <div class="marquee-item flex-shrink-0 w-28 h-20 bg-brand-card border border-brand-border rounded-xl p-3 flex items-center justify-center">
                  {b.logo_url ? (
                    <img src={b.logo_url} alt={b.name} class="max-w-full max-h-full object-contain" loading="lazy" title={b.name} />
                  ) : (
                    <span class="text-brand-muted text-xs text-center font-medium leading-tight">{b.name}</span>
                  )}
                </div>
              ))}
            </div>
          </div>

          <!-- Row 2 — right to left (reverse) -->
          <div class="marquee-track" data-speed="28" data-reverse="true">
            <div class="marquee-inner flex gap-4">
              {[...brands, ...brands].reverse().map((b, i) => (
                <div class="marquee-item flex-shrink-0 w-28 h-20 bg-brand-card border border-brand-border rounded-xl p-3 flex items-center justify-center">
                  {b.logo_url ? (
                    <img src={b.logo_url} alt={b.name} class="max-w-full max-h-full object-contain" loading="lazy" title={b.name} />
                  ) : (
                    <span class="text-brand-muted text-xs text-center font-medium leading-tight">{b.name}</span>
                  )}
                </div>
              ))}
            </div>
          </div>
        </div>
      )}
    </section>

    <!-- CTA -->
    <section class="py-16 sm:py-28 px-4 bg-brand-black">
      <div class="max-w-3xl mx-auto text-center" data-aos="fade-up">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-brand-white mb-4 sm:mb-5">
          ¿Su marca podría estar aquí?
        </h2>
        <p class="text-brand-muted text-sm sm:text-base mb-8 sm:mb-10 leading-relaxed">
          Contáctenos y le explicamos cómo podemos ayudarle a crecer digitalmente.
        </p>
        <a
          href="https://wa.me/56938897621?text=Hola%20ReClub%2C%20vi%20su%20portafolio%20y%20me%20gustaría%20saber%20más."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-gradient-to-r from-brand-blue to-brand-purple text-white px-10 py-4 rounded-xl font-semibold hover:scale-105 active:scale-95 transition-transform duration-200 shadow-lg shadow-brand-blue/20"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Contactar por WhatsApp
        </a>
      </div>
    </section>

  </main>
  <Footer />
  <WhatsAppButton />
</Layout>

<style>
  /* Marquee */
  .marquee-track { overflow: hidden; }
  .marquee-inner { display: flex; gap: 1rem; width: max-content; will-change: transform; }
  .marquee-item { flex-shrink: 0; }
  @media (prefers-reduced-motion: reduce) {
    .marquee-inner { animation: none !important; }
  }

  /* Instagram embed */
  .instagram-embed-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .instagram-embed-frame {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
</style>

<script>
  // Marquee animation
  document.querySelectorAll<HTMLElement>('.marquee-track').forEach(track => {
    const inner = track.querySelector<HTMLElement>('.marquee-inner')!;
    const speed = Number(track.dataset.speed ?? 40); // px/s
    const reverse = track.dataset.reverse === 'true';

    // The inner contains 2 copies of the list — scroll by half = one full loop
    let pos = reverse ? -inner.scrollWidth / 2 : 0;
    let raf: number;
    let paused = false;

    const items = inner.querySelectorAll('.marquee-item');
    const halfWidth = inner.scrollWidth / 2;

    function tick(last: number, ts: number) {
      const dt = Math.min(ts - last, 50); // cap delta to avoid jump after tab switch
      if (!paused) {
        pos += reverse ? (speed * dt) / 1000 : -(speed * dt) / 1000;
        // loop
        if (!reverse && pos <= -halfWidth) pos += halfWidth;
        if (reverse && pos >= 0) pos -= halfWidth;
        inner.style.transform = `translateX(${pos}px)`;
      }
      raf = requestAnimationFrame((ts2) => tick(ts, ts2));
    }

    raf = requestAnimationFrame((ts) => tick(ts, ts));

    // Pause on hover
    track.addEventListener('mouseenter', () => { paused = true; });
    track.addEventListener('mouseleave', () => { paused = false; });
  });
</script>
