---
import sql from '../../lib/db';

const { token } = Astro.params;
const rows = await sql`SELECT * FROM s90_clients WHERE client_token = ${token!} LIMIT 1`;
if (!rows[0]) return Astro.redirect('/sistema-90');

const client = rows[0] as any;
const onbRows = await sql`SELECT data FROM s90_onboarding WHERE client_id = ${client.id} ORDER BY submitted_at DESC LIMIT 1`;
const onb = (onbRows[0] as any)?.data ?? {};

const start = new Date(client.start_date);
const end = new Date(start); end.setDate(end.getDate() + 89);
const fmt = (d: Date) => d.toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });
const today = fmt(new Date());
const startStr = fmt(start);
const endStr = fmt(end);
const day30 = new Date(start); day30.setDate(day30.getDate() + 29);
const day60 = new Date(start); day60.setDate(day60.getDate() + 59);

const planA = client.plan === 'unico';
const clinicName = client.clinic_name ?? '_______________';
const contactName = onb.contact_name ?? client.contact_name ?? '_______________';
const contactRole = onb.contact_role ?? '_______________';
const rut = onb.rut && onb.rut.trim() ? onb.rut : '_______________';
const address = onb.address ? `${onb.address}${onb.commune ? ', ' + onb.commune : ''}` : '_______________';
---

<!doctype html>
<html lang="es" style="background:#fff !important;">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Contrato Sistema 90 — {clinicName}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <script>document.documentElement.setAttribute('style','background:#fff!important');document.addEventListener('DOMContentLoaded',function(){document.body.setAttribute('style','background:#fff!important;color:#1a1a1a!important');});</script>
  <script src="https://cdn.jsdelivr.net/npm/html2pdf.js@0.10.1/dist/html2pdf.bundle.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { background: #FFFFFF !important; color: #1A1A1A !important; font-family: 'Inter', sans-serif; margin: 0; padding: 0; }
    #page-root { background: #FFFFFF; min-height: 100vh; position: relative; z-index: 0; }

    /* Barra superior */
    .topbar { background: #0A0A0F; color: #F5F5F7; padding: 12px 24px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 50; }
    .topbar-left { display: flex; flex-direction: column; }
    .topbar-title { font-size: 13px; font-weight: 600; }
    .topbar-sub { font-size: 11px; color: #5C5C6A; margin-top: 2px; }
    .topbar-actions { display: flex; align-items: center; gap: 12px; }
    .btn-back { font-size: 12px; color: #5C5C6A; text-decoration: none; transition: color .2s; }
    .btn-back:hover { color: #F5F5F7; }
    .btn-download { background: #F5F5F7; color: #0A0A0F; font-size: 13px; font-weight: 600; padding: 9px 20px; border-radius: 100px; border: none; cursor: pointer; transition: background .2s; display: flex; align-items: center; gap-6px; gap: 6px; }
    .btn-download:hover { background: #D0D0D0; }

    /* Página del documento */
    .page-wrap { padding: 0 20px 80px; }
    #documento {
      background: #fff;
      max-width: 760px;
      margin: 0 auto;
      padding: 64px 72px;
      box-shadow: none;
      border-radius: 0;
    }

    /* Membrete */
    .membrete { display: flex; justify-content: space-between; align-items: flex-start; padding-bottom: 28px; border-bottom: 2px solid #0A0A0F; margin-bottom: 40px; }
    .membrete-logo { font-size: 20px; font-weight: 800; letter-spacing: -0.03em; color: #0A0A0F; }
    .membrete-sub { font-size: 10px; color: #888; margin-top: 3px; }
    .membrete-right { text-align: right; }
    .membrete-right p { font-size: 10px; color: #888; line-height: 1.6; }

    /* Título */
    .doc-title { font-family: 'Instrument Serif', serif; font-size: 34px; font-weight: 400; color: #0A0A0F; line-height: 1.15; margin-bottom: 8px; }
    .doc-subtitle { font-size: 12px; color: #888; margin-bottom: 36px; }

    /* Comparecientes */
    .partes { font-size: 13px; line-height: 1.8; color: #444; margin-bottom: 36px; }
    .partes p { margin-bottom: 10px; }
    .partes strong { color: #0A0A0F; }
    .dato { color: #0A0A0F; font-weight: 500; }

    /* Cláusulas */
    .clausula { margin-bottom: 28px; }
    .clausula-titulo { font-size: 11px; font-weight: 600; color: #0A0A0F; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 10px; padding-bottom: 6px; border-bottom: 1px solid #E8E8E8; }
    .clausula-body { font-size: 13px; line-height: 1.8; color: #444; }
    .clausula-body strong { color: #0A0A0F; }

    /* Listas */
    .lista { list-style: none; font-size: 13px; line-height: 1.8; color: #444; }
    .lista li { display: flex; gap: 10px; margin-bottom: 6px; }
    .lista li .letra { color: #0A0A0F; font-weight: 600; min-width: 16px; }

    /* Tablas */
    .tabla { width: 100%; border-collapse: collapse; font-size: 12px; margin: 12px 0; }
    .tabla thead tr { background: #0A0A0F; color: #fff; }
    .tabla thead th { padding: 10px 12px; text-align: left; font-weight: 500; letter-spacing: 0.03em; }
    .tabla tbody td { padding: 9px 12px; border-bottom: 1px solid #F0F0F0; color: #444; vertical-align: top; line-height: 1.5; }
    .tabla tbody tr:last-child td { border-bottom: none; }
    .tabla tbody tr.selected { background: #F7F7FF; }
    .tabla .check { color: #16A34A; font-weight: 700; }

    /* Firmas */
    .firmas { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; margin-top: 56px; padding-top: 32px; border-top: 1px solid #E8E8E8; }
    .firma-linea { height: 56px; border-bottom: 1.5px solid #0A0A0F; margin-bottom: 12px; }
    .firma-nombre { font-size: 13px; font-weight: 600; color: #0A0A0F; }
    .firma-cargo { font-size: 11px; color: #888; margin-top: 3px; }

    /* Footer doc */
    .doc-footer { display: flex; justify-content: space-between; margin-top: 48px; padding-top: 16px; border-top: 1px solid #E8E8E8; font-size: 10px; color: #AAA; }

    @media print {
      body { background: #fff; }
      .topbar { display: none; }
      .page-wrap { padding: 0; }
      #documento { box-shadow: none; border-radius: 0; padding: 48px 56px; max-width: 100%; }
    }

    @media (max-width: 600px) {
      #documento { padding: 32px 24px; }
      .firmas { grid-template-columns: 1fr; gap: 32px; }
      .membrete { flex-direction: column; gap: 8px; }
      .membrete-right { text-align: left; }
    }
  </style>
</head>
<body>
<div id="page-root">

  <!-- Barra -->
  <div class="topbar no-print">
    <div class="topbar-left">
      <span class="topbar-title">Contrato Sistema 90</span>
      <span class="topbar-sub">{clinicName}</span>
    </div>
    <div class="topbar-actions">
      <a href={`/panel/${token}`} class="btn-back">← Mi panel</a>
      <button class="btn-download" id="btnDescarga">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
        Descargar PDF
      </button>
    </div>
  </div>

  <!-- Documento -->
  <div class="page-wrap" style="background:#fff;">
  <div id="documento">

    <!-- Membrete -->
    <div class="membrete">
      <div>
        <div class="membrete-logo">ReClub</div>
        <div class="membrete-sub">reclubcl.com</div>
      </div>
      <div class="membrete-right">
        <p>Sistema 90 · Contrato</p>
        <p>{today}</p>
      </div>
    </div>

    <!-- Título -->
    <h1 class="doc-title">Contrato de Prestación<br>de Servicios</h1>
    <p class="doc-subtitle">Programa Sistema 90 — Contenido, Meta Ads y ventas por WhatsApp para clínicas estéticas</p>

    <!-- Comparecientes -->
    <div class="partes">
      <p>En Viña del Mar, a {today}, comparecen:</p>
      <p><strong>PRESTADOR:</strong> Benjamín Tapia Riquelme, RUT _______________, con domicilio en Viña del Mar, quien presta servicios bajo la marca ReClub (en adelante, "el Prestador").</p>
      <p><strong>CLIENTE:</strong> <span class="dato">{clinicName}</span>, RUT <span class="dato">{rut}</span>, representada por <span class="dato">{contactName}</span>{contactRole !== '_______________' ? `, ${contactRole}` : ''}, con domicilio en <span class="dato">{address}</span> (en adelante, "el Cliente").</p>
      <p>Las partes acuerdan el siguiente contrato de prestación de servicios, que se regirá por las cláusulas que siguen.</p>
    </div>

    <!-- PRIMERO -->
    <div class="clausula">
      <div class="clausula-titulo">Primero. Objeto</div>
      <p class="clausula-body">El Prestador se obliga a ejecutar para el Cliente el programa "Sistema 90", que comprende la producción de contenido audiovisual, la gestión de campañas publicitarias en Meta (Facebook e Instagram), la configuración de WhatsApp Business y asesoría comercial, con el objetivo de aumentar las consultas y pacientes agendados de la clínica del Cliente.</p>
    </div>

    <!-- SEGUNDO -->
    <div class="clausula">
      <div class="clausula-titulo">Segundo. Duración</div>
      <p class="clausula-body">El programa dura 90 días corridos. Comienza el <strong>{startStr}</strong> (Día 1), fecha de la reunión de estrategia inicial, la que solo se realizará una vez recibido el pago inicial indicado en la cláusula Séptima, y termina el <strong>{endStr}</strong> (Día 90).</p>
    </div>

    <!-- TERCERO -->
    <div class="clausula">
      <div class="clausula-titulo">Tercero. Entregables</div>
      <p class="clausula-body" style="margin-bottom:12px;">El Prestador entregará lo siguiente durante los 90 días:</p>
      <table class="tabla">
        <thead><tr><th>Entregable</th><th>Detalle</th><th>Cantidad</th></tr></thead>
        <tbody>
          {[
            ['Reunión de estrategia inicial','Diagnóstico, tratamientos foco, público objetivo y metas.','1'],
            ['Jornadas de grabación','Grabación en la clínica de hasta 4 horas cada una, una por mes.','3'],
            ['Reels editados','Edición profesional, subtítulos, música y portada. Una ronda de ajustes por reel.','24 a 30'],
            ['Campañas Meta Ads','Estructura, anuncios, segmentación y optimización continua.','90 días'],
            ['WhatsApp Business','Perfil, catálogo, respuestas rápidas y mensaje de bienvenida.','1'],
            ['Asesoría en ventas','Guion de respuesta y revisión de conversaciones.','Guion + 3 revisiones'],
            ['Reuniones de revisión','Reporte mensual y ajuste de hoja de ruta.','3 (Días 30, 60 y 90)'],
            ['Reporte final','Resultados de los 90 días y recomendaciones.','1'],
          ].map(([e,d,c]) => (
            <tr><td>{e}</td><td>{d}</td><td>{c}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- CUARTO -->
    <div class="clausula">
      <div class="clausula-titulo">Cuarto. Fases del proyecto</div>
      <table class="tabla">
        <thead><tr><th>Fase</th><th>Período</th><th>Qué se hace</th></tr></thead>
        <tbody>
          {[
            ['0. Activación','Días 1–7','Formulario de bienvenida, entrega de accesos, reunión de estrategia y configuración de WhatsApp Business.'],
            ['1. Lanzar','Días 1–30','Primera grabación, 8 a 10 reels, lanzamiento de campañas y guion de ventas. Cierra con revisión Día 30.'],
            ['2. Optimizar','Días 31–60','Segunda grabación, optimización de anuncios y revisión de conversaciones. Cierra con revisión Día 60.'],
            ['3. Escalar','Días 61–90','Tercera grabación, concentración del presupuesto en anuncios ganadores, reporte final y cierre Día 90.'],
          ].map(([f,p,d]) => (
            <tr><td>{f}</td><td>{p}</td><td>{d}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- QUINTO -->
    <div class="clausula">
      <div class="clausula-titulo">Quinto. Obligaciones del Cliente</div>
      <ul class="lista">
        {[
          'Pagar la inversión publicitaria directamente a Meta con su propio medio de pago. Se recomienda un mínimo de $150.000 mensuales. Este monto no está incluido en el precio del programa.',
          'Entregar los accesos necesarios dentro de los primeros 3 días hábiles desde la firma.',
          'Coordinar y facilitar las jornadas de grabación: espacio, disponibilidad de profesionales y, cuando corresponda, pacientes que acepten participar.',
          'Obtener la autorización escrita de toda persona que aparezca en el contenido.',
          'Aprobar u observar los contenidos dentro de 48 horas hábiles desde su envío. Pasado ese plazo, se entenderán aprobados.',
          'Responder oportunamente las consultas generadas por las campañas. La conversión depende de la gestión comercial del Cliente.',
          'Entregar información veraz sobre tratamientos y precios, y contar con las autorizaciones sanitarias que exija la normativa.',
        ].map((item, i) => (
          <li><span class="letra">{String.fromCharCode(97+i)})</span><span>{item}</span></li>
        ))}
      </ul>
    </div>

    <!-- SEXTO -->
    <div class="clausula">
      <div class="clausula-titulo">Sexto. Obligaciones del Prestador</div>
      <ul class="lista">
        {[
          'Ejecutar los entregables con diligencia y dentro de los plazos de cada fase.',
          'Crear los anuncios conforme a las Políticas de Publicidad de Meta, incluidas las restricciones aplicables a tratamientos estéticos y de salud.',
          'Informar los resultados en cada reunión de revisión y mantener comunicación por WhatsApp.',
          'Guardar reserva de la información del Cliente según la cláusula Undécima.',
        ].map((item, i) => (
          <li><span class="letra">{String.fromCharCode(97+i)})</span><span>{item}</span></li>
        ))}
      </ul>
    </div>

    <!-- SÉPTIMO -->
    <div class="clausula">
      <div class="clausula-titulo">Séptimo. Precio y forma de pago</div>
      <p class="clausula-body" style="margin-bottom:12px;">El Cliente elige una de las siguientes modalidades:</p>
      <table class="tabla">
        <thead><tr><th>Modalidad</th><th>Pago inicial</th><th>Pagos siguientes</th><th>Total</th></tr></thead>
        <tbody>
          <tr class={planA ? 'selected' : ''}>
            <td><span class="check">{planA ? '✓ ' : ''}</span>A. Pago único</td>
            <td>$990.000 al firmar</td>
            <td>—</td>
            <td><strong>$990.000</strong></td>
          </tr>
          <tr class={!planA ? 'selected' : ''}>
            <td><span class="check">{!planA ? '✓ ' : ''}</span>B. Tres cuotas</td>
            <td>$400.000 al firmar</td>
            <td>$400.000 el {day30.toLocaleDateString('es-CL',{day:'numeric',month:'short'})} y $400.000 el {day60.toLocaleDateString('es-CL',{day:'numeric',month:'short'})}</td>
            <td><strong>$1.200.000</strong></td>
          </tr>
        </tbody>
      </table>
      <p class="clausula-body" style="margin-top:10px;"><strong>Modalidad elegida: {planA ? 'A — Pago único.' : 'B — Tres cuotas.'}</strong> El pago inicial es requisito para iniciar el programa. Los pagos se realizan por transferencia bancaria o tarjeta. Si una cuota se atrasa más de 5 días hábiles, el Prestador podrá suspender los servicios hasta regularizar el pago, sin extender la duración del programa.</p>
    </div>

    <!-- Cláusulas restantes -->
    {[
      {n:'Octavo', t:'Resultados', b:'El Prestador se compromete a ejecutar los entregables aplicando buenas prácticas de contenido y publicidad. No garantiza un número específico de pacientes, ventas ni costo por resultado, ya que estos dependen también de factores externos como el funcionamiento de las plataformas de Meta, la competencia, los precios y la gestión comercial del Cliente.'},
      {n:'Noveno', t:'Propiedad del contenido', b:'Pagado íntegramente el programa, el Cliente será dueño del material editado entregado y podrá usarlo libremente. El material en bruto quedará en poder del Prestador por 60 días desde el término. El Prestador podrá mostrar los contenidos y métricas en su portafolio, salvo oposición escrita del Cliente, y sin revelar datos de pacientes.'},
      {n:'Décimo', t:'Cuentas y accesos', b:'Las campañas se ejecutarán en la cuenta publicitaria del Cliente. El Prestador accederá como socio a través de su Business Manager. El Cliente conserva en todo momento la propiedad de sus cuentas, páginas, audiencias y datos, y podrá retirar los accesos al término del contrato.'},
      {n:'Undécimo', t:'Confidencialidad y datos personales', b:'Las partes mantendrán reserva sobre la información de la otra a la que accedan con motivo de este contrato. El Prestador usará los datos de pacientes solo para prestar el servicio y conforme a la normativa chilena vigente sobre protección de datos personales.'},
      {n:'Duodécimo', t:'Reprogramaciones', b:'Las jornadas de grabación y reuniones podrán reprogramarse con al menos 48 horas de aviso. Una grabación cancelada con menos aviso, salvo caso fortuito, podrá reprogramarse una sola vez dentro de la misma fase; de lo contrario, se considerará realizada.'},
      {n:'Decimotercero', t:'Término anticipado', b:'Cualquiera de las partes podrá poner término con un aviso escrito de 15 días. Los montos pagados no son reembolsables. En la modalidad B, el Cliente pagará las cuotas vencidas a la fecha de término. Si una parte incumple gravemente sus obligaciones, la otra podrá poner término de inmediato mediante aviso escrito.'},
      {n:'Decimocuarto', t:'Continuidad', b:'En la reunión del Día 90, el Prestador presentará una propuesta de continuidad. El contrato no se renueva automáticamente.'},
      {n:'Decimoquinto', t:'Domicilio', b:'Para todos los efectos de este contrato, las partes fijan su domicilio en la ciudad de Viña del Mar y se someten a la competencia de sus tribunales ordinarios.'},
    ].map(c => (
      <div class="clausula">
        <div class="clausula-titulo">{c.n}. {c.t}</div>
        <p class="clausula-body">{c.b}</p>
      </div>
    ))}

    <!-- Firmas -->
    <div class="firmas">
      <div>
        <div class="firma-linea"></div>
        <div class="firma-nombre">Benjamín Tapia Riquelme</div>
        <div class="firma-cargo">RUT _______________</div>
        <div class="firma-cargo">Prestador — ReClub</div>
      </div>
      <div>
        <div class="firma-linea"></div>
        <div class="firma-nombre">{contactName}</div>
        <div class="firma-cargo">RUT {rut}</div>
        <div class="firma-cargo">Cliente — {clinicName}</div>
      </div>
    </div>

    <!-- Footer -->
    <div class="doc-footer">
      <span>Benjamín Tapia Riquelme · ReClub · reclubcl.com</span>
      <span>Sistema 90 · Contrato</span>
    </div>

  </div>
  </div>

</div><!-- /page-root -->
</body>
<script>
document.getElementById('btnDescarga')?.addEventListener('click', async () => {
  const btn = document.getElementById('btnDescarga') as HTMLButtonElement;
  btn.textContent = 'Generando...';
  btn.disabled = true;

  const el = document.getElementById('documento')!;
  const opt = {
    margin: 0,
    filename: `Contrato_Sistema90_${document.title.replace('Contrato Sistema 90 — ','').replace(/\s+/g,'_')}.pdf`,
    image: { type: 'jpeg', quality: 0.98 },
    html2canvas: { scale: 2, useCORS: true, letterRendering: true },
    jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
  };
  await (window as any).html2pdf().set(opt).from(el).save();

  btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg> Descargar PDF`;
  btn.disabled = false;
});
</script>
</html>
