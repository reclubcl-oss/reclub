---
import Layout from '../layouts/Layout.astro';
const clinic = Astro.url.searchParams.get('clinic') ?? '';
const MY_WHATSAPP = '+56938897621';
const CALENDAR_LINK = '[LINK_AGENDA]';
const VIDEO_URL = '[URL_VIDEO_BIENVENIDA]';
---

<Layout
  title="¡Bienvenida a Sistema 90! — ReClub"
  description="Tu acceso al programa Sistema 90 de ReClub."
  noindex
>
  <main class="min-h-screen bg-brand-black text-brand-white px-6 py-16 flex flex-col items-center">
    <div class="w-full max-w-xl mx-auto">

      <!-- Logo -->
      <div class="text-center mb-12">
        <a href="/" class="text-brand-white font-semibold text-lg tracking-tight">ReClub</a>
        <p class="text-brand-muted text-xs tracking-[0.2em] uppercase mt-2">Sistema 90</p>
      </div>

      <!-- Titular -->
      <div class="text-center mb-10">
        <h1 class="font-serif mb-3" style="font-size:clamp(32px,6vw,52px);font-weight:400;line-height:1.1;letter-spacing:-0.03em;">
          ¡Bienvenida a<br/><em style="font-style:italic;color:rgba(245,245,247,0.6);">Sistema 90!</em>
        </h1>
        {clinic && (
          <p class="text-brand-muted text-lg mt-2">{clinic}</p>
        )}
        <p class="text-brand-muted text-sm mt-4 leading-relaxed max-w-sm mx-auto">
          Tomaste la mejor decisión para hacer crecer tu clínica. En los próximos 90 días vamos a construir algo poderoso juntos.
        </p>
      </div>

      <!-- Video placeholder -->
      <div class="rounded-2xl overflow-hidden mb-10 border border-brand-border" style="aspect-ratio:16/9;background:#0D0D0D;">
        {VIDEO_URL === '[URL_VIDEO_BIENVENIDA]' ? (
          <div class="w-full h-full flex flex-col items-center justify-center gap-3">
            <div class="w-14 h-14 rounded-full border border-brand-border flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-6 h-6 text-brand-muted ml-1">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
            <p class="text-brand-muted text-xs tracking-wider uppercase">Video de bienvenida próximamente</p>
          </div>
        ) : (
          <iframe src={VIDEO_URL} class="w-full h-full" allow="autoplay; fullscreen" frameborder="0"></iframe>
        )}
      </div>

      <!-- 3 pasos -->
      <div class="mb-10">
        <p class="text-xs tracking-[0.2em] uppercase text-brand-muted mb-6">Tus próximos 3 pasos</p>
        <div class="space-y-0">
          {[
            {
              n: '01',
              title: 'Completa el formulario de bienvenida',
              desc: 'Son 10 minutos. Nos ayudas a conocer tu clínica en profundidad.',
              action: { label: 'Ir al formulario →', href: '/onboarding' + (clinic ? `?clinic=${encodeURIComponent(clinic)}` : ''), primary: true },
            },
            {
              n: '02',
              title: 'Entrega los accesos',
              desc: 'Cuenta publicitaria de Meta, Instagram y WhatsApp Business. El formulario incluye el instructivo.',
              action: null,
            },
            {
              n: '03',
              title: 'Agenda tu reunión de estrategia',
              desc: 'Nos juntamos a planificar los primeros 30 días.',
              action: { label: 'Agendar reunión →', href: CALENDAR_LINK, primary: false },
            },
          ].map((step, i) => (
            <div class="relative flex gap-5 pb-8">
              <!-- Línea conectora -->
              {i < 2 && (
                <div class="absolute left-[18px] top-[40px] bottom-0 w-px" style="background:linear-gradient(to bottom,#1C1C24,transparent);"></div>
              )}
              <!-- Círculo -->
              <div class="w-9 h-9 rounded-full border border-brand-border flex items-center justify-center shrink-0 bg-brand-card">
                <span class="text-xs font-medium text-brand-muted">{step.n}</span>
              </div>
              <!-- Contenido -->
              <div class="pt-1 flex-1">
                <h3 class="font-serif text-brand-white mb-1" style="font-size:18px;font-weight:400;letter-spacing:-0.01em;">{step.title}</h3>
                <p class="text-brand-muted text-sm leading-relaxed mb-3">{step.desc}</p>
                {step.action && (
                  <a
                    href={step.action.href}
                    class={`inline-flex items-center gap-2 text-sm font-semibold px-5 py-2.5 rounded-full transition-colors ${step.action.primary ? 'bg-brand-white text-brand-black hover:bg-brand-blue-dark' : 'border border-brand-border text-brand-muted hover:text-brand-white hover:border-brand-muted'}`}
                  >
                    {step.action.label}
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- WhatsApp -->
      <a
        href={`https://wa.me/${MY_WHATSAPP.replace('+', '')}?text=${encodeURIComponent(`Hola Benjamín, ya pagué el Sistema 90${clinic ? ` de ${clinic}` : ''}`)}`}
        target="_blank"
        class="flex items-center justify-center gap-3 w-full py-4 rounded-2xl border border-[#25d366]/30 bg-[#25d366]/5 hover:bg-[#25d366]/10 transition-colors text-sm font-semibold text-brand-white"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#25d366" class="w-5 h-5">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Escríbele a Benjamín por WhatsApp
      </a>

      <p class="text-center text-brand-muted text-xs mt-8">¿Ya tienes acceso? <a href="/panel/login" class="underline hover:text-brand-white">Entrar a mi panel</a></p>
    </div>
  </main>
</Layout>
